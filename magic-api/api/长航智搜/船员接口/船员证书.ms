import log;
import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import 'org.springblade.common.utils.DesensitizationUtil' as DesensitizationUtil;
import log;
import response;
import 'org.springblade.common.utils.ZzSecurityHelper' as ZzSecurityHelper;



//海员证

var idCardNo=(body.idCardNo==null?"":body.idCardNo).replace("<em>","").replace("</em>","");
idCardNo=ZzSecurityHelper.decryptAES(body.idCardNo);
idCardNo = idCardNo.replace("<em>","").replace("</em>","");

if(idCardNo==null || idCardNo==''){
    return  response.json({
        "code": 0,
        "message": "参数[idCardNo]为必填项",
        "data": {},      
        "executeTime": 2
    });
}
var type=body.type;
if(type==null || type==''){
    return  response.json({
        "code": 0,
        "message": "参数[type]为必填项",
        "data": {},      
        "executeTime": 2
    });
}
var status=body.status;
if(status==null || status==''){
    return  response.json({
        "code": 0,
        "message": "参数[status]为必填项",
        "data": {},      
        "executeTime": 2
    });
}

var sql1 = """
select id_card_no,CERT_NO,
       '海员证' as type,
       CERT_PRINT_NO,
       '' as  regi_cate,
       APPL_FORM ,
       ISSU_ORG_CODE,
       case when to_char(EXPIRY_DATE,'yyyy-mm-dd')='1900-01-01' then '' else  to_char(EXPIRY_DATE,'yyyy-mm-dd')  end  EXPIRY_DATE,
       case when to_char(ISSU_DATE, 'yyyy-mm-dd')='1900-01-01' then '' else  to_char(ISSU_DATE, 'yyyy-mm-dd') end  ISSU_DATE,
       case
         when cert_status = '0' then
          '无效'
         else
          '有效'
       end cert_status
  from bds_base_data.CREW_CERT_SEAMAN
where  1=1  
and  delete_flag='0'
?{idCardNo,and id_card_no = #{idCardNo}} 
 ?{status!='all',and cert_status = #{status}} 
 order by cert_status desc
"""

//适任证
var sql2 = """
select * from  (
   select id_card_no,serial_no, CERT_NO,COMP_TYPE_NAME ,
'内河适任证' as cert_type,
CERT_PRINT_NO,
   APPL_FORM ,
   ISSU_ORG_CODE,
   case when to_char(ISSU_DATE, 'yyyy-mm-dd')='1900-01-01'  then '' else to_char(ISSU_DATE, 'yyyy-mm-dd') end   ISSU_DATE,
       case
         when cert_status = '0' then
          '无效'
         else
          '有效'
       end cert_status,
      case when   to_char(EXPIRY_DATE,'yyyy-mm-dd')='1900-01-01'  then ''
      when  to_char(EXPIRY_DATE,'yyyy-mm-dd')='9999-01-01'  
      then '' else to_char(EXPIRY_DATE,'yyyy-mm-dd')  end  EXPIRY_DATE
from  bds_base_data.CREW_CERT_INL_CMPT 
where  1=1  
and  delete_flag='0'
?{idCardNo,and id_card_no = #{idCardNo}} 
 ?{status!='all',and cert_status = #{status}} 
 union 
 select id_card_no,serial_no, CERT_NO,COMP_TYPE_NAME,
'海船适任证' as cert_type,
CERT_PRINT_NO,
   APPL_FORM ,
   ISSU_ORG_CODE,
   case when to_char(ISSU_DATE, 'yyyy-mm-dd')='1900-01-01' then '' else to_char(ISSU_DATE, 'yyyy-mm-dd') end   ISSU_DATE,
       case
         when cert_status = '0' then
          '无效'
         else
          '有效'
       end cert_status,
       case when to_char(EXPIRY_DATE,'yyyy-mm-dd')='1900-01-01' then '' else to_char(EXPIRY_DATE,'yyyy-mm-dd') end  EXPIRY_DATE
from  bds_base_data.CREW_CERT_SEAMAN_CMPT
where  1=1  
and delete_flag='0'
?{idCardNo,and id_card_no = #{idCardNo}} 
 ?{status!='all',and cert_status = #{status}} 
 union 
 select id_card_no,serial_no, CERT_NO,COMP_TYPE_NAME,
'小型海船适任证' as cert_type,
CERT_PRINT_NO,
   APPL_FORM ,
   ISSU_ORG_CODE,
   case when to_char(ISSU_DATE, 'yyyy-mm-dd')='1900-01-01'  then '' else to_char(ISSU_DATE, 'yyyy-mm-dd') end ISSU_DATE,
       case
         when cert_status = '0' then
          '无效'
         else
          '有效'
       end cert_status,
      case when to_char(EXPIRY_DATE,'yyyy-mm-dd')='1900-01-01'  then '' else to_char(EXPIRY_DATE,'yyyy-mm-dd') end   EXPIRY_DATE
from  bds_base_data.CREW_CERT_SMALL_SEAMAN 
where  1=1  
and delete_flag='0'
?{idCardNo,and id_card_no = #{idCardNo}} 
 ?{status!='all',and cert_status = #{status}} 
 union 
 select id_card_no,serial_no, CERT_NO,COMP_TYPE_NAME,
'引航员适任证' as cert_type,
CERT_PRINT_NO,

   APPL_FORM ,
   ISSU_ORG_CODE,
  case when  to_char(ISSU_DATE, 'yyyy-mm-dd')='1900-01-01' then '' else to_char(ISSU_DATE, 'yyyy-mm-dd') end ISSU_DATE,
       case
         when cert_status = '0' then
          '无效'
         else
          '有效'
       end cert_status,
       case when to_char(EXPIRY_DATE,'yyyy-mm-dd')='1900-01-01' then '' else to_char(EXPIRY_DATE,'yyyy-mm-dd')  END  EXPIRY_DATE
from  bds_base_data.CREW_CERT_PILOT_CMPT
where  1=1  
and delete_flag='0'
?{idCardNo,and id_card_no = #{idCardNo}} 
 ?{status!='all',and cert_status = #{status}} 

)
order by cert_status desc

"""


