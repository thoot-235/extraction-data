ret.put("hyzlist", hyzlist);
ret.put("srzlist", srzlist);
ret.put("fwblist", fwblist);
ret.put("hgzlist", hgzlist);
ret.put("jkzlist", jkzlist);
ret.put("ytjslist", ytjslist);
ret.put("hjjlist", hjjlist);
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    result: ret
});