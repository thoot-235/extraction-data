import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;
import 'org.springblade.common.utils.ZzSecurityHelper' as ZzSecurityHelper;
//idCardNo = (idCardNo == null ? "" : idCardNo).replace("<em>", "").replace("</em>", "");

var idCardNo=(body.idCardNo==null?"":body.idCardNo).replace("<em>","").replace("</em>","");
idCardNo=ZzSecurityHelper.decryptAES(body.idCardNo);
idCardNo = idCardNo.replace("<em>","").replace("</em>","");
if(idCardNo==null || idCardNo==''){
    return  response.json({
        "code": 0,
        "message": "参数[idCardNo]为必填项",
        "data": {},      
        "executeTime": 2
    });
}
 var sql="""
          SELECT
            s.TRAIN_ITEM_CODE train_Item_Name,
           (SELECT COMP_NAME FROM BDS_BASE_DATA.ORG_CREW_BASIC_INFO WHERE COMP_ID = a.TRAIN_ORG_ID )  as train_Org_Name,
           a.TRAIN_ORG_ID,
            case when to_char(a.SCHE_CLAS_TIME,'yyyy-MM-dd')='1900-01-01' then '--' else to_char(a.SCHE_CLAS_TIME,'yyyy-MM-dd')  end  sche_Clas_Time,
            s.ATTENDENCE||'%' attendence,
            a.WORKORDER_NO workorder_No,
            s.TRAINPROOF_NO trainproof_No,
            case when to_char(a.SCHE_GRADUATION_TIME,'yyyy-MM-dd')='1900-01-01' then '--' else to_char(a.SCHE_GRADUATION_TIME,'yyyy-MM-dd')  end sche_Graduation_Time,
            '' proof_End_Time 
            FROM
            bds_biz_data.CREW_AHEP_STU s, bds_biz_data.CREW_AHEP a
            where a.WORKORDER_NO = s.WORKORDER_NO 
            ?{idCardNo,and  s.ID_CARD_NO = #{idCardNo}}
            and a.APPL_STATE = '4' 
            and s.confirm_result='1'
            and a.delete_flag='0'
            and s.delete_flag='0'
            ORDER BY a.SCHE_CLAS_TIME DESC
 """
  var ret=db.biz_data.camel().select(sql);
  for(item in ret){
      item.put("trainItemName",TagUtils.getTagNameByCode("trainItemCodeTag",item.get("trainItemName")));
     if(item.get("trainOrgName")==null||"".equals(item.get("trainOrgName"))){
        item.put("trainOrgName",item.get("trainOrgId"));
     }
  }
  	return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: ret
	});