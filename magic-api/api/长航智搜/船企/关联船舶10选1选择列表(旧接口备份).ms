import 'com.success.data.tag.TagUtils' as TagUtils;
import log;
import response;

uscc=(uscc==null?"":uscc).replace("<em>","").replace("</em>","");
var sql1 = """
  SELECT ORGANIZATION_CODE COMPANYID,
       COMPANY_NAME,
       ORGANIZATION_CODE,
       case  when TO_CHAR(REG_DATE, 'yyyy-MM-dd')='1900-01-01' then '--'  else TO_CHAR(REG_DATE, 'yyyy-MM-dd') end  REG_DATE,
       LEGAL_REPRESENTATIVE,
       REGCAPITAL,
       COMPANY_REG_ADDR ADDRESS,
       CONTACT_PERSON,
       MOBILE_PHONE,
       MAILING_ADDRESS,
       FAX,
       USCC,
       WEB_SITE,
       COMPANY_TYPE NATURE_CODE,
       TRANS_LIC_NO BUSINESS_NO,      
       TRANS_SERV_LIC_NO LICENSE_NO,
       MANAGE_NO,
       PORT_LICENSE_NO,
       IF_OBTAIN,
       case when to_char(OBTAIN_DATE,'yyyy-MM-dd')='1900-01-01' then '--' else to_char(OBTAIN_DATE,'yyyy-MM-dd') end  OBTAIN_DATE,
       INTER_CERT_NO,
       INTER_LICENSE_CODE,
       INTER_SHIP_LICENSE_CODE,
       COMPANY_OPERATE_SCOP,
       AUTHORITY,
       OPENTIME
  from BDS_BASE_DATA.company_info_all_update
  where 1=1  ?{uscc,and uscc = #{uscc}}
  union all 
  SELECT ORGANIZATION_CODE COMPANYID,
       COMPANY_NAME,
       ORGANIZATION_CODE,
       case  when TO_CHAR(REG_DATE, 'yyyy-MM-dd')='1900-01-01' then '--'  else TO_CHAR(REG_DATE, 'yyyy-MM-dd') end  REG_DATE,
       LEGAL_REPRESENTATIVE,
       REGCAPITAL,
       COMPANY_REG_ADDR ADDRESS,
       CONTACT_PERSON,
       MOBILE_PHONE,
       MAILING_ADDRESS,
       FAX,
       USCC,
       WEB_SITE,
       COMPANY_TYPE NATURE_CODE,
       TRANS_LIC_NO BUSINESS_NO,      
       TRANS_SERV_LIC_NO LICENSE_NO,
       MANAGE_NO,
       PORT_LICENSE_NO,
       IF_OBTAIN,
       case when to_char(OBTAIN_DATE,'yyyy-MM-dd')='1900-01-01' then '--' else to_char(OBTAIN_DATE,'yyyy-MM-dd') end  OBTAIN_DATE,
       INTER_CERT_NO,
       INTER_LICENSE_CODE,
       INTER_SHIP_LICENSE_CODE,
       COMPANY_OPERATE_SCOP,
       AUTHORITY,
       OPENTIME
  from BDS_BASE_DATA.company_info_all
  where 1=1  ?{uscc,and uscc = #{uscc}}
  and ORGANIZATION_CODE not in (select ORGANIZATION_CODE from BDS_BASE_DATA.company_info_all_update)
"""

var basic = db.base_data.camel().selectOne(sql1);//查询船舶基本信息

var shipList = [];
 var sqlShip;
if(basic!=null&&basic!=""){//根据uscc能查询到船企基本信息
    var companyName=basic.get("companyName")
    var sql = """
    select '船舶登记' as data_source,
                          -- r.ref_code,
                          -- ref_name,
                          s.ship_reg_no,
                          s.ship_id,
                          s.ship_imo,
                           s.ship_firstreg_no as ship_no,
                          s.mmsi,
                          s.status_flag,
                          s.ship_name_cn,
                          s.ship_type_code,
                          s.regport_code,
                          case
                            when to_char(s.ship_built_date, 'yyyy-mm-dd') =
                                  '1900-01-01' then
                              '--'
                            else
                              to_char(s.ship_built_date, 'yyyy-mm-dd')
                          end ship_built_date,
                          s.sailingarea_code,
                          s.create_time
                      from (select ship_reg_no,
                                  listagg(ref_code, ',') within group(order by ref_code) as ref_code,
                                  listagg(ref_name, ',') within group(order by ref_code) as ref_name
                              from (select distinct ship_reg_no,
                                                            '1' ref_code,
                                                            '所有人' ref_name
                                              from bds_base_data.shp_cert_ownership
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and ship_owner_cn like  #{companyName}|| '%'
                                            union 
                                            select distinct ship_reg_no,
                                                            '1' ref_code,
                                                            '所有人' ref_name
                                              from bds_base_data.shp_cert_ownership
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and reverse(ship_owner_cn) like  #{companyName}|| '%'
                                            union
                                            --船舶国籍证书表，按照经营人、管理人、所有人查询，只查状态为有效的。
                                            select distinct ship_reg_no,
                                                            '1' ref_code,
                                                            '所有人' ref_name
                                              from bds_base_data.shp_cert_national
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and ship_owner_en like  #{companyName}|| '%'
                                            union  
                                            select distinct ship_reg_no,
                                                            '1' ref_code,
                                                            '所有人' ref_name
                                              from bds_base_data.shp_cert_national
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and reverse(ship_owner_en) like  #{companyName}|| '%'
                                            union
                                            select distinct ship_reg_no,
                                                            '2' ref_code,
                                                            '经营人' ref_name
                                              from bds_base_data.shp_cert_national
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and ship_operator_cn =
                                                  #{companyName}
                                            union
                                            select distinct ship_reg_no,
                                                            '3' ref_code,
                                                            '管理人' ref_name
                                              from bds_base_data.shp_cert_national
                                            where status_flag = '1'
                                              and delete_flag = '0'
                                              and ship_manager_cn = #{companyName}
                                          
                                          
                                            union 
                                            --岸电系统
                                            select ship_reg_no,
                                                  '2' ref_code,
                                                  '经营人' ref_name
                                              from shore_power_ship_info a
                                              left join shore_power_company_info b
                                                on a.company_uscc = b.company_uscc
                                            where b.sh_status = 2
                                              and b.del_flag = 0
                                              and a.del_flag = 0
                                              and b.company_name = #{companyName}
                                            union 
                                            --运政系统
                                            select t1.ship_reg_no,
                                                  '2' ref_code,
                                                  '经营人' ref_name
                                              from bds_base_data.trans_mgt_company_ship t,
                                                  bds_base_data.shp_basic_data         t1
                                            where t1.delete_flag = '0'
                                              and t1.status_flag = '1'
                                              and t.ship_id = t1.ship_id
                                              and company_name = #{companyName})
                            group by ship_reg_no) r
                      inner join bds_base_data.shp_basic_data s
                        on r.ship_reg_no = s.ship_reg_no where s.status_flag='1'
      """
      
          shipList= db.base_data.camel().select( sql );
      var shipNo="";
      for(ship in shipList){
          ship.put("shipTypeCn",TagUtils.getTagNameByCode("shipClassTag",ship.get("shipTypeCode")));//船舶种类
          ship.put("regportCn",TagUtils.getTagNameByCode("shipRegportTag",ship.get("regportCode")));//船籍港
          ship.put("sailingareaCn",TagUtils.getTagNameByCode("shipRouteAreaTag",ship.get("sailingareaCode")));//航区
          shipNo=ship.get("shipNo");
            
      }
      
   
      if(shipList.size()>=1){
         sqlShip="""
           
          SELECT '船舶登记' as data_source,
                                    -- r.ref_code,
                                    -- ref_name,
                                    s.ship_reg_no,
                                    s.ship_id,
                                    s.ship_imo,
                                    'A' || s.ship_firstreg_no as ship_no,
                                    s.mmsi,
                                    s.status_flag,
                                    s.ship_name_cn,
                                    s.ship_type_code,
                                    s.regport_code,
                                    case
                                      when to_char(s.ship_built_date, 'yyyy-mm-dd') =
                                            '1900-01-01' then
                                        '--'
                                      else
                                        to_char(s.ship_built_date, 'yyyy-mm-dd')
                                    end ship_built_date,
                                    s.sailingarea_code,
                                    s.create_time  FROM (
            SELECT * FROM bds_base_data.shp_basic_data WHERE ship_firstreg_no = #{shipNo}
            )  s WHERE ROWNUM <= 1
          UNION ALL
          SELECT '船舶登记' as data_source,
                                    -- r.ref_code,
                                    -- ref_name,
                                    s.ship_reg_no,
                                    s.ship_id,
                                    s.ship_imo,
                                    'A' || s.ship_firstreg_no as ship_no,
                                    s.mmsi,
                                    s.status_flag,
                                    s.ship_name_cn,
                                    s.ship_type_code,
                                    s.regport_code,
                                    case
                                      when to_char(s.ship_built_date, 'yyyy-mm-dd') =
                                            '1900-01-01' then
                                        '--'
                                      else
                                        to_char(s.ship_built_date, 'yyyy-mm-dd')
                                    end ship_built_date,
                                    s.sailingarea_code,
                                    s.create_time FROM (
            SELECT * FROM bds_base_data.shp_basic_data WHERE ship_firstreg_no <> #{shipNo}
            )s WHERE ROWNUM <= 9
      """
      }else{
        sqlShip="""
           
          SELECT '船舶登记' as data_source,
                                    -- r.ref_code,
                                    -- ref_name,
                                    s.ship_reg_no,
                                    s.ship_id,
                                    s.ship_imo,
                                    'A' || s.ship_firstreg_no as ship_no,
                                    s.mmsi,
                                    s.status_flag,
                                    s.ship_name_cn,
                                    s.ship_type_code,
                                    s.regport_code,
                                    case
                                      when to_char(s.ship_built_date, 'yyyy-mm-dd') =
                                            '1900-01-01' then
                                        '--'
                                      else
                                        to_char(s.ship_built_date, 'yyyy-mm-dd')
                                    end ship_built_date,
                                    s.sailingarea_code,
                                    s.create_time FROM (
            SELECT * FROM bds_base_data.shp_basic_data 
            )s WHERE ROWNUM <= 10
      """
      }
     

}else{//查询不到船企基本信息
    sqlShip="""
              
              SELECT '船舶登记' as data_source,
                                        -- r.ref_code,
                                        -- ref_name,
                                        s.ship_reg_no,
                                        s.ship_id,
                                        s.ship_imo,
                                        'A' || s.ship_firstreg_no as ship_no,
                                        s.mmsi,
                                        s.status_flag,
                                        s.ship_name_cn,
                                        s.ship_type_code,
                                        s.regport_code,
                                        case
                                          when to_char(s.ship_built_date, 'yyyy-mm-dd') =
                                                '1900-01-01' then
                                            '--'
                                          else
                                            to_char(s.ship_built_date, 'yyyy-mm-dd')
                                        end ship_built_date,
                                        s.sailingarea_code,
                                        s.create_time FROM (
                SELECT * FROM bds_base_data.shp_basic_data 
                )s WHERE ROWNUM <= 10
          """
}
var ship=db.base_data.camel().select(sqlShip);




return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: ship
	});