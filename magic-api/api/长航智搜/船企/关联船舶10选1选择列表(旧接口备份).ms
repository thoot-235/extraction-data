,\n        \"createTime\": \"2007-01-09 21:50:35\"\n    }, {\n        \"dataSource\": \"船舶登记\",\n        \"shipRegNo\": \"070407000009\",\n        \"shipId\": \"CN19999256113\",\n        \"shipImo\": \"\",\n        \"shipNo\": \"A070407000009\",\n        \"mmsi\": \"\",\n        \"statusFlag\": \"3\",\n        \"shipNameCn\": \"浙文库渡0002\",\n        \"shipTypeCode\": \"0103\",\n        \"regportCode\": \"0728\",\n        \"shipBuiltDate\": \"2000-08-01\",\n        \"sailingareaCode\": \"12\",\n        \"createTime\": \"2007-01-09 21:52:06\"\n    }, {\n        \"dataSource\": \"船舶登记\",\n        \"shipRegNo\": \"070407000010\",\n        \"shipId\": \"CN19998733101\",\n        \"shipImo\": \"\",\n        \"shipNo\": \"A070407000010\",\n        \"mmsi\": \"\",\n        \"statusFlag\": \"3\",\n        \"shipNameCn\": \"浙文库渡0004\",\n        \"shipTypeCode\": \"0103\",\n        \"regportCode\": \"0728\",\n        \"shipBuiltDate\": \"2000-09-01\",\n        \"sailingareaCode\": \"12\",\n        \"createTime\": \"2007-01-09 21:56:10\"\n    }, {\n        \"dataSource\": \"船舶登记\",\n        \"shipRegNo\": \"070407000011\",\n        \"shipId\": \"CN19994124048\",\n        \"shipImo\": \"\",\n        \"shipNo\": \"A070407000011\",\n        \"mmsi\": \"\",\n        \"statusFlag\": \"3\",\n        \"shipNameCn\": \"浙文库渡0005\",\n        \"shipTypeCode\": \"0103\",\n        \"regportCode\": \"0728\",\n        \"shipBuiltDate\": \"2000-08-01\",\n        \"sailingareaCode\": \"12\",\n        \"createTime\": \"2007-01-09 21:57:20\"\n    }, {\n        \"dataSource\": \"船舶登记\",\n        \"shipRegNo\": \"350315000041\",\n        \"shipId\": \"CN20099139991\",\n        \"shipImo\": \"\",\n        \"shipNo\": \"A350315000041\",\n        \"mmsi\": \"\",\n        \"statusFlag\": \"3\",\n        \"shipNameCn\": \"赣武宁货3306\",\n        \"shipTypeCode\": \"0201\",\n        \"regportCode\": \"3503\",\n        \"shipBuiltDate\": \"2009-10-30\",\n        \"sailingareaCode\": \"11\",\n        \"createT