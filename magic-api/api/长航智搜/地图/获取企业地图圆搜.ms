  "responseBody" : "{\n    \"code\": 200,\n    \"success\": \"查询成功\",\n    \"data\": {\n        \"records\": [{\n            \"total_count\": 243,\n            \"if_add_flag\": \"\",\n            \"gsmc\": \"武汉文峰船务运输有限公司\",\n            \"longitude\": \"114.16108903\",\n            \"latitude\": \"30.68199586\",\n            \"regno\": \"91420112799775172H\",\n            \"startdate\": \"2007-04-18\",\n            \"legalperson\": \"刘明寿\",\n            \"enttype\": \"\",\n            \"scope\": \"码头装卸；货运代理、咨询；建筑装饰材料、建材（不含油漆等危化物品）、玻璃、钢材、化肥产品、日用百货批发兼零售；；长江中下游干线及支流省际普通货船运输（许可项目经营期限与许可证核定期限一致）。（依法须经审批的项目，经相关部门审批后方可开展经营活动）\",\n            \"regaddr\": \"武汉市东西湖区径河农场十字东街7号(10)\"\n        }, {\n            \"total_count\": 243,\n            \"if_add_flag\": \"\",\n            \"gsmc\": \"武汉永亮航运有限公司\",\n            \"longitude\": \"114.38825927\",\n            \"latitude\": \"30.63651283\",\n            \"regno\": \"91420102059156712E\",\n            \"startdate\": \"2012-12-18\",\n            \"legalperson\": \"陶治平\",\n            \"enttype\": \"\",\n            \"scope\": \"水路普通货物运输；普通货物仓储服务（不含危险化学品等需许可审批的项目）；国内船舶代理；装卸搬运；建筑材料销售；金属材料销售；五金产品零售；日用百货销售；金属矿石销售；办公设备销售。（依法须经批准的项目，经相关部门批准后方可开展经营活动）\",\n            \"regaddr\": \"武汉市青山区和平大道1284号中银大厦第7层东侧、12E号卡位D区D064号\"\n        }, {\n            \"total_count\": 243,\n            \"if_add_flag\": \"\",\n            \"gsmc\": \"武汉海通船舶运输有限公司\",\n            \"longitude\": \"114.29084513\",\n            \"latitude\": \"30.57232629\",\n            \"regno\": \"914201007612143612\",\n            \"startdate\": \"2004-04-30\",\n            \"legalperson\": \"袁涛\",\n            \"enttype\": \"\",\n            \"scope\": \"长江干线及支流省际油船、散装化学品船运输；代办水、陆、铁联运业务。（国家有专项规定的项目经审批后或凭许可证在核定的期限内方可经营）\",\n            \"regaddr\": \"江汉区民权路２号\"\n        }, {\n            \"total_count\": 243,\n            \"if_add_flag\": \"\",\n            \"gsmc\": \"鄂州市三江油运有限责任公司\",\n            \"longitude\": \"114.89158739\",\n            \"latitude\": \"30.3931491