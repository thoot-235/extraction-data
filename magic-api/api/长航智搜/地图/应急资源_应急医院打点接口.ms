//医院名称、经度、纬度、地点、联系人、医疗队伍信息
var sql = """
  select name, longitude, latitude, address, leader, info
    from yjzy_data.yjxx_yy
  where scbj = '0'
  ?{name ,and name like '%'||#{name}||'%'}
  order by id
"""

var list = db.ods_data.camel().select(sql);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });