  "responseBody" : "{\n    \"code\": 200,\n    \"resultMsg\": \"查询成功\",\n    \"data\": [{\n        \"serviceAreaName\": \"四川段（泸州）水上绿色综合服务区\",\n        \"channel\": \"泰安水道\",\n        \"position\": \"长江上游航道里程约898km\",\n        \"longitude\": \"105.5567\",\n        \"latitude\": \"28.8986\",\n        \"motionUnit\": \"泸州市港池锚地水污染治理有限公司\",\n        \"serviceFunction\": \"物资采购、快递配送、配件采购、垃圾接收、船舶救助、行政管理服务、公益宣传、党员活动等。\",\n        \"remark\": \"\",\n        \"pontoonNum\": \"1\",\n        \"scale\": \"29.98*8\",\n        \"importTime\": \"2023-11-24 21:03:15\"\n    }, {\n        \"serviceAreaName\": \"鸡冠石水上绿色综合服务区\",\n        \"channel\": \"铜田坝水道\",\n        \"position\": \"长江上游航道里程约522.8-526.1km\",\n        \"longitude\": \"107.4696\",\n        \"latitude\": \"29.8093\",\n        \"motionUnit\": \"中石化长江燃料有限公司重庆分公司\",\n        \"serviceFunction\": \"燃料加注、船舶污染物接收处置、船员生活物资补给、快递收发、岸电供应等功能。\",\n        \"remark\": \"\",\n        \"pontoonNum\": \"2\",\n        \"scale\": \"90*18，60*10\",\n        \"importTime\": \"2023-11-24 21:03:15\"\n    }, {\n        \"serviceAreaName\": \"涪陵水上绿色综合服务区\",\n        \"channel\": \"菜籽梁水道\",\n        \"position\": \"长江上游航道里程约524km\",\n        \"longitude\": \"107.4608\",\n        \"latitude\": \"29.8043\",\n        \"motionUnit\": \"重庆市涪陵区大为船舶制造有限公司\",\n        \"serviceFunction\": \"燃料加注、船舶污染物接收处置、岸电、自来水供应等功能、货物过驳、船舶修造、船舶检修、船检管理服务、配\",\n        \"remark\": \"正改建，目前暂停运营\",\n        \"pontoonNum\": \"1\",\n        \"scale\": \"65*10\",\n        \"importTime\": \"2023-11-24 21:03:15\"\n    }, {\n        \"serviceAreaName\": \"中长燃岳阳莲花塘水上绿色综合服务区\",\n        \"channel\": \"观音洲水道\",\n        \"position\": \"长江中游航道里程约230km\",\n        \"longitude\": \"109.3215\",\n        \"latitude\": \"30.9656\",\n        \"motionUnit\": \"中石化长江燃料有限公司岳阳分公司\",\n        \"serviceFunction\": \"船舶水污染物接收、船舶油料供应、船舶淡水供应、快递配送、海事自助服务、船员生活物资补给、船舶垃圾接收\",\n        \"remark\": \"\",\n        \"pontoonNum\": \"1\",\n        \"scale\": \"89.22*15\",\n        \"importTime\": \"2023-1