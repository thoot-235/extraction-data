import response;

var sql="""
select 
SERVICE_AREA_NAME,
CHANNEL,
POSITION,
LONGITUDE,
LATITUDE,
MOTION_UNIT,
SERVICE_FUNCTION,
REMARK,
PONTOON_NUM,
SCALE,
IMPORT_TIME	
from WATER_GREEN_SERVICE_AREA t where 1=1 
?{serviceAreaName,and t.SERVICE_AREA_NAME like  '%'||#{serviceAreaName}||'%'}
"""
var list=db.hs_share.camel().select(sql);
if (list == null) {
    list = [];
}
return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});