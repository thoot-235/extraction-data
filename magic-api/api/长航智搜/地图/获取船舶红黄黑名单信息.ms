import response;

var sql="""
 select distinct ID,
        INFO_ID,
        SHIP_CHINESE_NAME,
        SHIP_ENGLISH_NAME,
        CAPTAIN_NAME,
        SHIP_REGISTRATION_NO,
        OW_CARD_TYPE,
        OW_CARD_NO,
        SHIP_PORT_REGISTRY,
        SHIP_OWNER,
        SHIP_OPERATOR,
        OW_ADMIN_COUNTERPART_TYPE,
        STATUS,
        CAPTAIN_CARD_TYPE,
        CAPTAIN_CARD_NO,
        OW_ADMIN_COUNTERPART_CODE_TYPE,
        OW_ADMIN_COUNTERPART_CODE,
        OW_LEGAL_PERSON,
        OW_LEGAL_PERSON_TYPE,
        OW_LEGAL_IDCARD_NO,
        OP_ADMIN_COUNTERPART_TYPE,
        OP_ADMIN_COUNTERPART_CODE_TYPE,
        OP_ADMIN_COUNTERPART_CODE,
        OP_LEGAL_PERSON,
        OP_LEGAL_PERSON_TYPE,
        OP_LEGAL_IDCARD_NO,
        OP_CARD_TYPE,
        OP_CARD_NO,
        to_char(DISHONESTY,'yyyy-MM-dd hh:mi:ss') DISHONESTY,
        BOINS_TYPE_ID,
        REFORM_REASON_DESC
        from t_CREDIt_BODY_SHIP where 1=1
        and info_id in(select id  from t_credit_YELLOW_list union all select id  from t_credit_black_list  union all select id  from t_credit_red_list )
        ?{shipNameCn, and SHIP_CHINESE_NAME = #{shipNameCn}}
         ?{shipNameEn,and SHIP_ENGLISH_NAME = #{shipNameEn}}
         ?{shipRegNo,  and SHIP_REGISTRATION_NO = #{shipRegNo}}
"""
var ret=db.hs_share.camel().select(sql);
var data={};
if(ret!=null&&ret.size()>0){
     var infoId=ret.get(0).get("infoId");
     var  redsql="""
       select distinct ID,
            DATA_SOURCE,
            to_char(CREATE_TIME,'yyyy-MM-dd hh:mi:ss') CREATE_TIME,
            QCREIID,
            CREATE_NAME,
            USER_NAME,
            HEAR_BUREAU_ID,
            HEAR_BUREAU_NAME,
            LINKMAN_NAME,
            LINKMAN_CARD_ID,
            LINKMAN_PHONE,
            CREDIT_BODY_TYPE,
            to_char(PUBLIC_TIME,'yyyy-MM-dd hh:mi:ss') PUBLIC_TIME,
            to_char(AFFIRM_TIME,'yyyy-MM-dd hh:mi:ss') AFFIRM_TIME,
            CREDIT_BODY_ID,
            STATUS,
            BOINS_ID,
            EXTEND1,
            EXTEND2,
            EXTEND3,
            POST_STATUS,
            EID,
            AFFIRM_REASON,
            AFFIRM_REASON_DESC,
            INDATE,
            to_char(EXPIRY_DATE,'yyyy-MM-dd hh:mi:ss') EXPIRY_DATE,
            to_char(ESC_DATE,'yyyy-MM-dd hh:mi:ss') ESC_DATE,
            ESC_REASON,
            CASE_NO
            from t_credit_red_list t where id = #{infoId}
     """
     var redret=db.hs_share.camel().select(redsql);
     data.put("red",redret);
     var yellowsql="""
      select distinct ID,
            DATA_SOURCE,
            to_char(CREATE_TIME,'yyyy-MM-dd hh:mi:ss') CREATE_TIME,
            QCREIID,
            CREATE_NAME,
            USER_NAME,
            HEAR_BUREAU_ID,
            HEAR_BUREAU_NAME,
            LINKMAN_NAME,
            LINKMAN_CARD_ID,
            LINKMAN_PHONE,
            CREDIT_BODY_TYPE,
            IS_RECTIFICATION,
            to_char(AFFIRM_TIME,'yyyy-MM-dd hh:mi:ss') AFFIRM_TIME,
            CREDIT_BODY_ID,
            STATUS,
            BOINS_ID,
            EXTEND1,
            EXTEND2,
            EXTEND3,
            EID,
            AFFIRM_REASON,
            AFFIRM_REASON_DESC,
            to_char(DISHONEST_DATE,'yyyy-MM-dd hh:mi:ss') DISHONEST_DATE,
            INDATE,
            to_char(EXPIRY_DATE,'yyyy-MM-dd hh:mi:ss') EXPIRY_DATE,
            to_char(ESC_DATE,'yyyy-MM-dd hh:mi:ss') ESC_DATE,
            ESC_REASON,
            IS_BLACK,
            IS_EXPIRY,
            CASE_NO
          
            from t_credit_yellow_list t where id =#{infoId}
     """
 var yellowret=db.hs_share.camel().select(yellowsql);
  data.put("yellow",yellowret);
     var  blacksql="""
      select distinct ID,
            DATA_SOURCE,
            to_char(CREATE_TIME,'yyyy-MM-dd hh:mi:ss') CREATE_TIME,
            QCREIID,
            CREATE_NAME,
            USER_NAME,
            HEAR_BUREAU_ID,
            HEAR_BUREAU_NAME,
            LINKMAN_NAME,
            LINKMAN_CARD_ID,
            LINKMAN_PHONE,
            CREDIT_BODY_TYPE,
            to_char(PUBLIC_TIME,'yyyy-MM-dd hh:mi:ss') PUBLIC_TIME,
            to_char(AFFIRM_TIME,'yyyy-MM-dd hh:mi:ss') AFFIRM_TIME,
            CREDIT_BODY_ID,
            STATUS,
            BOINS_ID,
            EXTEND1,
            EXTEND2,
            EXTEND3,
            POST_STATUS,
            AFFIRM_REASON,
            AFFIRM_REASON_DESC,
            to_char(DISHONEST_DATE,'yyyy-MM-dd hh:mi:ss') DISHONEST_DATE,
            INDATE,
            to_char(EXPIRY_DATE,'yyyy-MM-dd hh:mi:ss') EXPIRY_DATE,
            to_char(ESC_DATE,'yyyy-MM-dd hh:mi:ss') ESC_DATE,
            ESC_REASON,
            CASE_NO
            from t_credit_black_list t where id = #{infoId}
     """
      var blackret=db.hs_share.camel().select(blacksql);
data.put("black",blackret);
}
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: data
});