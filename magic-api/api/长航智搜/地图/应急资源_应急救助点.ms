var sql = """
select 
relief_point_name,
affiliated_unit,
location,
longitude,
latitude,
longitude||','||latitude position,
case when contact_information like '%内线：%' 
 then replace(contact_information,'内线：',';') 
 else contact_information 
 end as contact_information
from ods_yj_emergency_relief_points
where 1=1
?{name ,and relief_point_name =#{name}}
order by id
"""
var list = db.ods_data.camel().select(sql);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });