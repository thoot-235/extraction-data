//机构名称、地址、经度、纬度、机构简要介绍、应急负责人
var sql = """
  select name, address, lon, lat, summer, yjfzr
    from yjzy_data.yjxx_gljg
    where scbj = '0'
  ?{name ,and name like '%'||#{name}||'%'}
  order by id desc
"""

var list = db.ods_data.camel().select(sql);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });