import response;

var Sql = """select id ,
         if_add_flag,
        COMPANY_NAME gsmc ,
        qytp ,
        gqctt ,
        qygxtp ,
        qytp_id ,
        gsjbxx ,
        COMPANY_OPERATE_ADDR new_addr ,
        qy_describe ,
        lat latitude,
        lng longitude,
        MOBILE_PHONE telephone ,
        gszcxx ,
        COMPANY_NAME entname ,
        USCC regno ,
        LEGAL_REPRESENTATIVE legalperson ,
        OPEN_STATUS openstatus ,
        START_TIME startdate ,
        district ,
        regcapital ,
        paidincapital ,
        COMPANY_TYPE enttype ,
        industry ,
        regcode ,
        ORGANIZATION_CODE  orgno ,
        taxno ,
        qualification ,
        opentime ,
        annualdate ,
        authority ,
        insurancenum ,
        preventname ,
        COMPANY_REG_ADDR regaddr ,
        COMPANY_OPERATE_SCOP scope ,MAILING_ADDRESS email,CONTACT_PERSON
        from company_info_all s
        where 1=1
        ?{wharfName,and s.company_name like '%'||#{wharfName}||'%'}
        ?{regno,and s.USCC = #{regno}}
        """;
var list = db.ais.camel().selectOne(Sql);
if (list == null) {
    list = [];
}
return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});