import response;
var sql="""
SELECT    LEAVE_TIME,  
       SHIP_ID,
       SHIP_NAME_CN,
       SHIP_NAME_EN,
       MMSI,
       SHIP_IMO,
       STATUS
       FROM (
SELECT PORT_CODE,
       LEAVE_TIME,
       SHIP_ID,
       SHIP_NAME_CN,
       SHIP_NAME_EN,
       MMSI,
       SHIP_IMO,
       CASE WHEN ARRIVAL_OR_LEAVE='0' THEN '进港' ELSE '离港' END  STATUS
  FROM (SELECT REPORT_PORT_CODE PORT_CODE，TO_CHAR(EXPECT_TIME, 'YYYY-MM-DD HH24:MI:SS') LEAVE_TIME,
               SHIP_ID,
               SHIP_NAME_CN,
               SHIP_NAME_EN,
               MMSI,
               SHIP_IMO,ARRIVAL_OR_LEAVE
          FROM BDS_BIZ_DATA.RPT_SHIP_EEP_REPORT_REC
         WHERE  DELETE_FLAG = '0'
        --   AND REPORT_TIME > TRUNC(SYSDATE)
 AND TO_CHAR(REPORT_TIME,'yyyy-mm-dd')='2018-01-01'
           ) A,
       (  SELECT * FROM  DICT_DATA.D_CB_PORT WHERE ITEM_NAME_CN ='上海') P
 WHERE A.PORT_CODE = P.CODE
UNION ALL
SELECT INS.PORT_CODE,
       INS.LEAVE_TIME,
       D.SHIP_ID,
       D.SHIP_NAME_CN,
       D.SHIP_NAME_EN,
       D.MMSI,
       D.SHIP_IMO,
       CASE WHEN INSP_TYPE='IMP' THEN '进港' ELSE '出港' END STATUS
  FROM (SELECT SHIP_NO,
               PORT_CODE,
               TO_CHAR(DEPART_TIME, 'YYYY-MM-DD HH24:MI:SS') LEAVE_TIME,
               INSP_TYPE
          FROM (SELECT * FROM  SUB_BIZ_DATA.SHP_INSPECTION WHERE DEPART_TIME > TRUNC(SYSDATE))  A, (SELECT * FROM  DICT_DATA.D_CB_PORT WHERE ITEM_NAME_CN = '上海' )P
         WHERE A.PORT_CODE = P.CODE
          
            ) INS,
       BDS_BASE_DATA.SHP_BASIC_DATA D
 WHERE 'A' || D.SHIP_FIRSTREG_NO = INS.SHIP_NO
UNION ALL
SELECT INS.PORT_CODE,
       INS.LEAVE_TIME,
       D.SHIP_ID,
       D.SHIP_NAME_CN,
       D.SHIP_NAME_EN,
       D.MMSI,
       D.SHIP_IMO,
       CASE WHEN INSP_TYPE='IMP' THEN '进港' ELSE '出港' END STATUS
  FROM (SELECT SHIP_NO,
               PORT_CODE,
               TO_CHAR(DEPART_TIME, 'YYYY-MM-DD HH24:MI:SS') LEAVE_TIME,
               INSP_TYPE
         FROM  (SELECT * FROM  SUB_BIZ_DATA.SHP_INSPECTION WHERE DEPART_TIME > TRUNC(SYSDATE))  A, (SELECT * FROM  DICT_DATA.D_CB_PORT WHERE ITEM_NAME_CN = '上海')P
         WHERE A.PORT_CODE = P.CODE
           ) INS,
       BDS_BASE_DATA.SHP_BASIC_DATA D
 WHERE 'B' || D.SHIP_IMO = INS.SHIP_NO
   ) ORDER BY LEAVE_TIME DESC
   
"""
var  ret=db.biz_data.camel().page(sql);
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: ret 

});