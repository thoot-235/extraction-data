import response;

var sql="""
select 
SITE_NO,
SITE_NAME,
SITE_ATTRIBUTE,
replace(LONGITUDE,'°','') as LONGITUDE,
replace(LATITUDE,'°','') as LATITUDE,
SITE_LOCATION,
IMPORT_TIME	
from BEIDOU_BASE_STATION t where 1=1 
?{siteName,and t.SITE_NAME like  '%'||#{siteName}||'%'}
"""
var list=db.hs_share.camel().select(sql);
if (list == null) {
    list = [];
}
return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});