        "type" : "",
        "defaultValue" : "",
        "validateType" : "",
        "error" : "",
        "expression" : "",
        "children" : [ ]
      } ]
    } ]
  }
}
================================
import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;

var fsList="";
for(val in body.fsList){
    fsList = fsList +val.replace(","," ").replace("(","").replace(")","") +",";
}
fsList=fsList.substring(0,fsList.length()-1);



var limit=""" ) a 
limit 
        (#{body.size}) ::bigint  offset 
         ((#{body.current})  ::bigint-1) * (#{body.size}) ::bigint 
"""      ;  
        
var Sql = """
       select * from (
         select count(*) OVER() "total_count" , id as "id",
         gkdm   "gkdm",
          gkzwmc  "gkzwmc",
          gkywmc  "gkywmc",
          gj  "gj",
         hx   "hx",
         gjywmc   "gjywmc",
         js   "js",
         lon   "lon",
         lat   "lat",
         clbz   "clbz",
        country_code    "country_code",
        ifAddFlag    "ifAddFlag"  from SEARCH_GK_QQGKQD b
        where 1 = 1 
        and 
        public.ST_Contains(
public.st_geometryfromtext ('polygon (("""+fsList+"""))',4326) ,
public.st_geometryfromtext (concat('POINT (',lon,' ',lat,')'),4326)    
)

?{body.gkzwmc, and b.gkzwmc like  '%'||#{body.gkzwmc}||'%' }
?{body.gj, and b.gj like  '%'||#{body.gj}||'%' }
 
 
and lon is not null and lat is not null
      

        """;

var list=db.ais.select(Sql+limit);
var totalCount=0;

if(list==null){
   list=[];
} 
for(item in list){ 
    totalCount = item.get("total_count");
}     
var back={
        "records":list,
        "total":Integer.parseInt(totalCount::string)
}

import response;
return response.json({
    code: 200,
    success: "查询成功",
    data: back 

});
