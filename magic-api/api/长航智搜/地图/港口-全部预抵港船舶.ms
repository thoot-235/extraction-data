import response;


        
var sql="""
select ARRIVE_TIME estimated_time,
       ship_id,
       ship_name_cn,
       ship_name_en,
       mmsi,
       SHIP_IMO,
       '进港' status
  from (select *
          from (select PORT_CODE,
                       ARRIVE_TIME,
                       ship_id,
                       ship_name_cn,
                       ship_name_en,
                       mmsi,
                       SHIP_IMO,
                       row_number() over(partition by a.mmsi order by ARRIVE_TIME desc) rn,
                       ARRIVAL_OR_LEAVE
                  from (select REPORT_PORT_CODE PORT_CODE，to_CHAR(EXPECT_TIME, 'YYYY-MM-DD HH24:MI:SS') ARRIVE_TIME,
                               ship_id,
                               ship_name_cn,
                               ship_name_en,
                               mmsi,
                               SHIP_IMO,
                               ARRIVAL_OR_LEAVE
                          from bds_biz_data.RPT_SHIP_EEP_REPORT_REC
                         where DELETE_FLAG = '0'
                                and if_revoke != '1'
                                and EXPECT_TIME >= sysdate
                                and EXPECT_TIME < trunc(sysdate) + 1) a,
                       dict_data.D_CB_PORT p
                 where a.PORT_CODE = p.code
                   and p.item_name_cn = #{portName}
                
                )
         order by ARRIVE_TIME)
 where rn = 1
   and ARRIVAL_OR_LEAVE = '0'
 order by ARRIVE_TIME
"""
var list=db.biz_data.camel().select(sql);
     
var list2;  
if(list!=null&&list!=""){
        var idList=[];
        for(itData in list){//查询预进港所有船舶，然后去pg库查询实时位置
                if(itData.get("mmsi")!=null&&itData.get("mmsi")!=""){
                        idList.add(Integer.decode(itData.get("mmsi")))
                }
              
        }
        if(idList.size()>=1){
                var sqlLon="""select longitude,latitude,mmsi, round(cast(course as numeric),4) course,
        round(cast(trueheading as numeric),4) trueheading,
        speed from  ais_pos_new_all where  1=1 and mmsi in 
                        <foreach collection="idList"  open="(" separator="," close=")" item="item">
                        #{item}
                        </foreach> """;
                 list2=db.ais.camel().select(sqlLon);
               
        }
        
}

if(list2!=null&&list2!=''){
   for(item in list2){
     for(item2 in list){
             if(item.get("mmsi")!=null&&item2.get("mmsi")!=null){
                        if(item.get("mmsi").toString().equals(item2.get("mmsi").toString())){     
                                item.putAll(item2);
                                }
             }
       
     }
   }
}
if(list2==null||list2==""){
list2=[];
}

//var  ret=db.biz_data.camel().page(sql);
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: list2 

});