import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;


var Sql = """


       select SWZ_ID, to_char(CLSJ, 'yyyy-mm-dd') CLSJ, ROUND(avg(nvl(CLSW,0)),2) clsw
  
 from ( select *  
  from bds_biz_data.SZ_SWDTJCLS
 where CLSJ <= sysdate
 and CLSJ >= (sysdate - 30)
 
 ?{swzId,and SWZ_ID = #{swzId}} )
  group by SWZ_ID, to_char(CLSJ, 'yyyy-mm-dd')
 order by CLSJ


        """;
var list=db.biz_data.camel().select(Sql);
if(list==null||list==''){
   list=[];
}
import response;
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: list 

});
