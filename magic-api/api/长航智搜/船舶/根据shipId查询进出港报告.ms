import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import 'org.springblade.common.utils.DesensitizationUtil' as DesensitizationUtil;

var cbSql;

cbSql = """
select total_count, rowno, REPORT_ID,REG_SHIP_ID,SHIP_ID,SHIP_REG_NO,SHIP_FIRSTREG_NO,SHIP_INSPECT_NO,SHIP_NAME_CN,SHIP_NAME_EN,SHIP_IMO,MMSI,
        SHIP_CALLSIGN,REGPORT_CODE,FLAG_STATE_CODE,SHIP_REGION_TYPE,SHIP_TYPE_CODE,SHIP_GROSSTON,SHIP_NETTON,SHIP_DWT,MAINENGINE_POWER,
        SHIP_PASSENGER_NUM,SHIP_LENGTH,SHIP_BREADTH,SHIP_DEPTH,LINE_CODE,AREA_CODE,CONSTRUCTION_DATE,SHIP_OWNER,OWNER_ADDRESS,OWNER_CONTACT_PHONE,
        OWNER_CORPORATION,SHIP_OPERATOR,OPERATOR_ADDRESS,OPERATOR_TELEPHONE,OPERATOR_CORPORATION,BUSINESS_CODE,REPORT_NO,ORG_CODE,REPORT_PORT_NAME,
        REPORT_PORT_CODE,ARRIVAL_OR_LEAVE,ARRIVAL_REPORT_ID,NEXT_PORT_NAME,NEXT_PORT_CODE,REPORT_TIME,BID_NAME,MOBILE_PHONE,EXPECT_TIME,
        IF_ANCHORED,DRAFT_FORWARD,AFT_DRAFT,BERTH_CODE,BERTH_NAME,OTHER_QUANTITY,ACTUAL_CARRYING_CAPACITY,PORT_CARGO,REAL_DANGER_CARGO,
        PORT_DANGER_CARGO,ACTUAL_CAPACITY,PORT_PASSENGER,REAL_VEHICLE,PORT_VEHICLE,NUM_OF_BARGE,PORT_BARGE,REAL_CONTAINER_QAY,PORT_CONTAINER_QAY,
        LONGITUDE,LATITUDE,IF_REVOKE,VOYAGE_REPORT,FREQUENCY,NAVIGATION_SECTION,PRE_PORT_NAME,PRE_PORT_CODE,rownumber
    from (select total_count,rownum rowno, REPORT_ID,REG_SHIP_ID,SHIP_ID,SHIP_REG_NO,SHIP_FIRSTREG_NO,SHIP_INSPECT_NO,SHIP_NAME_CN,SHIP_NAME_EN,SHIP_IMO,MMSI,
        SHIP_CALLSIGN,REGPORT_CODE,FLAG_STATE_CODE,SHIP_REGION_TYPE,SHIP_TYPE_CODE,SHIP_GROSSTON,SHIP_NETTON,SHIP_DWT,MAINENGINE_POWER,
        SHIP_PASSENGER_NUM,SHIP_LENGTH,SHIP_BREADTH,SHIP_DEPTH,LINE_CODE,AREA_CODE,CONSTRUCTION_DATE,SHIP_OWNER,OWNER_ADDRESS,OWNER_CONTACT_PHONE,
        OWNER_CORPORATION,SHIP_OPERATOR,OPERATOR_ADDRESS,OPERATOR_TELEPHONE,OPERATOR_CORPORATION,BUSINESS_CODE,REPORT_NO,ORG_CODE,REPORT_PORT_NAME,
        REPORT_PORT_CODE,ARRIVAL_OR_LEAVE,ARRIVAL_REPORT_ID,NEXT_PORT_NAME,NEXT_PORT_CODE,REPORT_TIME,BID_NAME,MOBILE_PHONE,EXPECT_TIME,
        IF_ANCHORED,DRAFT_FORWARD,AFT_DRAFT,BERTH_CODE,BERTH_NAME,OTHER_QUANTITY,ACTUAL_CARRYING_CAPACITY,PORT_CARGO,REAL_DANGER_CARGO,
        PORT_DANGER_CARGO,ACTUAL_CAPACITY,PORT_PASSENGER,REAL_VEHICLE,PORT_VEHICLE,NUM_OF_BARGE,PORT_BARGE,REAL_CONTAINER_QAY,PORT_CONTAINER_QAY,
        LONGITUDE,LATITUDE,IF_REVOKE,VOYAGE_REPORT,FREQUENCY,NAVIGATION_SECTION,PRE_PORT_NAME,PRE_PORT_CODE,rownumber
          from (
    select  count(*) OVER() total_count,
        e.REPORT_ID,e.REG_SHIP_ID,e.SHIP_ID,e.SHIP_REG_NO,e.SHIP_FIRSTREG_NO,e.SHIP_INSPECT_NO,e.SHIP_NAME_CN,e.SHIP_NAME_EN,e.SHIP_IMO,e.MMSI,
        e.SHIP_CALLSIGN,e.REGPORT_CODE,e.FLAG_STATE_CODE,e.SHIP_REGION_TYPE,e.SHIP_TYPE_CODE,e.SHIP_GROSSTON,e.SHIP_NETTON,e.SHIP_DWT,e.MAINENGINE_POWER,
        e.SHIP_PASSENGER_NUM,e.SHIP_LENGTH,e.SHIP_BREADTH,e.SHIP_DEPTH,e.LINE_CODE,e.AREA_CODE,e.CONSTRUCTION_DATE,e.SHIP_OWNER,e.OWNER_ADDRESS,e.OWNER_CONTACT_PHONE,
        e.OWNER_CORPORATION,e.SHIP_OPERATOR,e.OPERATOR_ADDRESS,e.OPERATOR_TELEPHONE,e.OPERATOR_CORPORATION,e.BUSINESS_CODE,e.REPORT_NO,e.ORG_CODE,
        case when e.REPORT_PORT_NAME is   null
          then 
            ( select PORT_NAME  from  dict_data.dim_l_t_location_info ins where ym=(select max(ym) from dict_data.dim_l_t_location_info) and ins.berth_code=e.berth_code)
            else e.REPORT_PORT_NAME
          end REPORT_PORT_NAME,
        e.REPORT_PORT_CODE,e.ARRIVAL_OR_LEAVE,e.ARRIVAL_REPORT_ID,e.NEXT_PORT_NAME,e.NEXT_PORT_CODE,e.REPORT_TIME,e.BID_NAME,e.MOBILE_PHONE,e.EXPECT_TIME,
        e.IF_ANCHORED,e.DRAFT_FORWARD,e.AFT_DRAFT,e.BERTH_CODE,e.BERTH_NAME,e.OTHER_QUANTITY,e.ACTUAL_CARRYING_CAPACITY,e.PORT_CARGO,e.REAL_DANGER_CARGO,
        e.PORT_DANGER_CARGO,e.ACTUAL_CAPACITY,e.PORT_PASSENGER,e.REAL_VEHICLE,e.PORT_VEHICLE,e.NUM_OF_BARGE,e.PORT_BARGE,e.REAL_CONTAINER_QAY,e.PORT_CONTAINER_QAY,
        e.LONGITUDE,e.LATITUDE,e.IF_REVOKE,e.VOYAGE_REPORT,e.FREQUENCY,e.NAVIGATION_SECTION,e.PRE_PORT_NAME,e.PRE_PORT_CODE
        ,row_number() over(order by ship_id DESC) as rownumber from bds_biz_data.RPT_SHIP_EEP_REPORT_REC e where delete_flag='0'
        and  SHIP_ID = #{shipId} 
        ?{beginTime,and report_time>=to_date( #{beginTime} ,'yyyy-mm-dd') }
         ?{endTime, and report_time<=to_date( #{endTime} ,'yyyy-mm-dd') }
         order by report_time desc
         ) b
              where rownum <= (#{page}*#{size})) a
              where a.rowno >((#{page}-1)* #{size})   
""";

import response
var list = db.biz_data.camel().select(cbSql);
var totalCount = 0;
for (item in list) {
    item.put("ifAnchored", TagUtils.getTagNameByCode("ifAnchored", item.get("ifAnchored")::string))
    item.put("ifRevoke", TagUtils.getTagNameByCode("ifRevoke", item.get("ifRevoke").toString()))
    item.put("arrivalOrLeave", TagUtils.getTagNameByCode("arrivalOrLeave", item.get("arrivalOrLeave")::string))
    item.put("orgCode", TagUtils.getTagNameByCode("issuOrgTag", item.get("orgCode")))
    item.put("offiSources", TagUtils.getTagNameByCode("isOwnTag", item.get("offiSources")))
     item.put("shipTypeCode",
        TagUtils.getTagNameByCode("shipClassTag", item.get("shipTypeCode")));
    //脱敏处理
    item.put("_mobilePhone", DesensitizationUtil.mobilePhone(item.get("mobilePhone")))
    totalCount = item.get("totalCount");
}
if (list == null) {
    list = [];
}
var back = {
    "list": list,
    "total": Integer.parseInt(totalCount::string)

}
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: back

});