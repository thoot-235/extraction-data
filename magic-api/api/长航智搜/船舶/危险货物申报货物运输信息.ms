import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;

var transSql = """ 
select count(*) over() total_count,
       carry_trans_id,
       carry_id,
       declare_type_code,
       declare_type_name,
       goods_type_code,
       goods_flow_code,
       goods_flow_name,
       goods_declare_no,
       bill_no,
       owner_name,
       consignor_name,
       consignee_name,
       shipper_name,
       carrier_name,
       total_weight,
       net_weight,
       depart_port_code,
       depart_port_name,
       load_port_code,
       load_port_name,
       unload_port_code,
       unload_port_name,
       dest_port_code,
       dest_port_name,
       shipment_type_code,
       shipment_type_name,
       cntr_type_code,
       cntr_type_name,
      case when  if_cntr_open_code='0' then '否'
      else '是' end if_cntr_open_code
      ,
       if_cntr_open_code_cn pack_type_code,
       pack_type_name,
       pack_material_code,
       pack_material_name,
       pack_num,
       cntr_size,
       cntr_num,
       pack_mark,
       if_contain_waste,
       if_contain_waste_cn,
       if_unclear,
       if_unclear_cn,
       if_lighter,
       if_lighter_cn,
       if_limit_code,
       if_limit_code_cn,
       if_max_code,
       if_max_code_cn,
       single_voyage_rpt_no,
       set_posi,
       goods_carry_id,
       operate_flag_code,
       remark
  from sub_biz_data.dgr_goods_trans
 where carry_trans_id = #{carryTransId}
   """;

  
var list = [];
var totalCount = 0;
    list = db.biz_data.camel().select(transSql);
for (item in list) {
    totalCount = item.get("totalCount");
}

if (list == null) {
    list = [];
}

totalCount = totalCount == null ? "0" : totalCount::string;
var back = {
    "list": list,
    "total": Integer.parseInt(totalCount)
}
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: back
});