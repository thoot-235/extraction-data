import 'com.success.data.tag.TagUtils' as TagUtils;
import response;
var  sql="""
select
'S' as value, '身份证'  as value_cn  from dual
union  select
'X' as value, '香港身份证'  as value_cn from dual
union  select
'A' as value, '澳门身份证'  as value_cn from dual
union  select
'T' as value, '台湾身份证'  as value_cn from dual
union  select
'J' as value, '军人证件' as value_cn from dual
union  select
 'Q' as value, '其他'  as value_cn from dual
"""
var cardType=db.ods_data.camel().select(sql);//证件号码


  sql="""SELECT distinct lpad(CODE,2,'0') as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_COMM_NATION 
"""
var nation=db.ods_data.camel().select(sql);//民族




 sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_COMM_POSITION 
"""
var position=db.ods_data.camel().select(sql);//职务


sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_COMM_TITLE 
"""
var title=db.ods_data.camel().select(sql);//职称


sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_COMM_EDUCATION 
"""
var education=db.ods_data.camel().select(sql);//学历


sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_COMM_DEGREE 
"""
var degee=db.ods_data.camel().select(sql);//学位


//sql="""SELECT comp_id as key, COMP_NAME as value FROM BDS_BASE_DATA.ORG_CREW_BASIC_INFO 
//"""
//var orgCrewBasicInfo=db.ods_data.camel().select(sql);//毕业院校

sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_COMM_MAJORS
"""
var majors=db.ods_data.camel().select(sql);//专业


sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CY_COUNTRY
"""
var country=db.ods_data.camel().select(sql);//国籍


sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CY_PASSPORT_TYPE
"""
var passportType=db.ods_data.camel().select(sql);//护照类型




var data={
    cardType:cardType,
    nation:nation,
    
    position:position,
    title:title,
    education:education,
    degee:degee,
    majors:majors,
    country:country,
    passportType:passportType
    


}

return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: data
	});



