import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.springblade.common.utils.ZzSecurityHelper' as ZzSecurityHelper;
import java.net.URLEncoder;
import response;
var ret = {};

if ((mmsi == null || mmsi == "") && (shipId == null || shipId == "")) {
    return response.json({
        resultCode: 500,
        resultMsg: "mmsi、shipId不能同时为空"
    });

}

mmsi = (mmsi == null ? "" : mmsi);
shipId = (shipId == null ? "" : shipId);
//船舶基本信息
var sql = """
    select *
        from (select a.*,case when ship_built_date is not null then to_char(trunc(months_between(sysdate,ship_built_date)/12))
                    else '--' end ship_age
                from bds_base_data.sc_ship_basic_data a
                --left join ods_hs_share.C_CB_OWNERSHIP_REG b on a.ship_reg_no = b.ship_reg_no
                where a.DELETE_FLAG='0'
               <trim prefix="and("  suffix=")" prefixOverrides="AND |OR ">
       <if test="mmsi != null and mmsi!=''">
             OR a.mmsi = #{mmsi}
      </if>
      <if test="shipId != null and shipId!=''">
             OR a.ship_id = #{shipId}
      </if>
     
  </trim>
                order by a.CREATE_TIME desc)
        where rownum = 1

"""
var sqlmap1 = """
    select distinct name from dict_data.CH_MARITIME_CODE where code = #{code}
"""
var sqlshiptype = """
    select distinct item_name_cn from dict_data.D_CB_SHIP_TYPE where code = #{shipTypeCode}
"""
var shipInfo = db.biz_data.camel().selectOne(sql);

if (shipInfo != null) {
    shipInfo.put("_shipId",URLEncoder.encode(ZzSecurityHelper.encryptAES(shipInfo.get("shipId"))));

    shipInfo.put("orgCode", db.biz_data.camel().selectOne(sqlmap1, {
        "code": shipInfo.get("orgCode")
    }) == null ? shipInfo.get("orgCode") : db.biz_data.camel().selectOne(sqlmap1, {
        "code": shipInfo.get("orgCode")
    }).get("name"));
    shipInfo.put("shipTypeCode", db.biz_data.camel().selectOne(sqlshiptype, {
        "shipTypeCode": shipInfo.get("shipTypeCode")
    }) == null ? shipInfo.get("shipTypeCode") : db.biz_data.camel().selectOne(sqlshiptype, {
        "shipTypeCode": shipInfo.get("shipTypeCode")
    }).get("itemNameCn"));


    // 船舶所有权证书信息
    var sql2 = """
        select b.ship_owner_cn, to_char(b.cert_obtain_date,'yyyy-MM-dd') cert_obtain_date
                from bds_base_data.sc_ship_basic_data a
                left join ods_hs_share.C_CB_OWNERSHIP_REG b on a.ship_reg_no = b.ship_reg_no
                where a.DELETE_FLAG='0' and a.STATUS_FLAG = '1'
               <trim prefix="and("  suffix=")" prefixOverrides="AND |OR ">
       <if test="mmsi != null and mmsi!=''">
             OR a.mmsi = #{mmsi}
      </if>
      <if test="shipId != null and shipId!=''">
             OR a.ship_id = #{shipId}
      </if>
     
  </trim>
                order by a.CREATE_TIME desc
    """
    var _shipRegNo = shipInfo.get("shipRegNo") == null ? "" : shipInfo.get("shipRegNo");
    if (_shipRegNo != null && _shipRegNo != "") {
        var ownerCert = db.biz_data.camel().selectOne(sql2);
        if (ownerCert != null) {
            shipInfo.put("shipOwner", ownerCert.get("shipOwnerCn"));
            shipInfo.put("certObtainDate", ownerCert.get("certObtainDate"));
        }
        //// 船舶国籍证书
        var sql3 = """
            select *
                from ods_hs_share.C_CB_NATIONAL_ISS_INFO
                where ship_reg_no = #{shipRegNo}
                and STATUS_FLAG = '1'
        """
        var shipNationalCert = db.biz_data.camel().selectOne(sql3, {
            "shipRegNo": _shipRegNo
        });
        if (shipNationalCert != null) {
            //shipInfo.put("shipOperator",shipNationalCert.get("shipOperatorCn"));

        }
        /**
        // 一船全景——船舶管理人
        var sql4="""
            select b.COMPANY_NAME as "shipManager"
                from ods_hs_share.C_AQ_MNG_SP_INFO a,
                    ods_hs_share.C_AQ_SHIPPING_COMPANY b
                where a.companyid = b.companyid
                and ship_primary_key = #{shipRegNo}
                and a.delete_flag = '0'
                and b.delete_flag = '0'
        """
        var shipManager=db.biz_data.camel().selectOne(sql4,{"shipRegNo":_shipRegNo});
        if(shipManager!=null){
            shipInfo.put("shipManager",shipNationalCert.get("shipManager")==null?"--":shipNationalCert.get("shipManager"));
        } */
    }
    var mmsi = shipInfo.get("mmsi")::int;
    var shipAisSql = """
    select 
    to_char(longitude,'FM9999999990.000000') as lon,to_char(latitude,'FM9999999990.000000') as lat,to_char(speed*1.852,'FM9999999990.0') as speed from ais_pos_new_all  where mmsi=#{mmsi} 
    """
    var shipAis = db.ais.camel().selectOne(shipAisSql);
    if (shipAis != null) {
        shipInfo.put("lon", shipAis.get("lon")::double);
        shipInfo.put("lat", shipAis.get("lat")::double);
        shipInfo.put("speed", shipAis.get("speed")::double);
    } else {
        shipInfo.put("lon", "");
        shipInfo.put("lat", "");
        shipInfo.put("speed", "");
    }
    ret.put("basicData", shipInfo);

    //船舶所有人
    var shipOwner = shipInfo.get("shipOwner");
    var shipOwnerUsccSql = """
        select uscc from bds_base_data.company_info_all where rownum = 1 and company_name = #{shipOwner}
    """
    var shipOwnerUscc = db.base_data.camel().selectValue(shipOwnerUsccSql);
    shipInfo.put("shipOwnerUscc", shipOwnerUscc);
    //船舶经营人
    var shipOperator = shipInfo.get("shipOperator");
    var shipOperatorUsccSql = """
        select uscc from bds_base_data.company_info_all where rownum = 1 and company_name = #{shipOperator}
    """
    var shipOperatorUscc = db.base_data.camel().selectValue(shipOperatorUsccSql);
    shipInfo.put("shipOperatorUscc", shipOperatorUscc);
    //船舶管理人
    var shipManager = shipInfo.get("shipManager");
    var shipManagerUsccSql = """
        select uscc from bds_base_data.company_info_all where rownum = 1 and company_name = #{shipManager}
    """
    var shipManagerUscc = db.base_data.camel().selectValue(shipManagerUsccSql);
    shipInfo.put("shipManagerUscc", shipManagerUscc);
    shipInfo.put("shipBuiltDate", shipInfo.get("shipBuiltDate")::string.substring(0, 10));
}

return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: ret
});