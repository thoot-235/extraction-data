import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;
import http;
import java.lang.Math;

var WaterStationSql = """
   select
        id,
        cjsj,
        gxsj,
        sjly,
        scbj,
        px,
        swzmc,
        zbjd,
        zbwd,
        case when hd_hdly='1' then '上游'
        when hd_hdly='2' then '中游'
        else '下游' end hd_hdly ,
        lcwz,
        qyzt,
        dtxz,
        ty_sjsbfs,
        lrmsfjxx,
        case when sz_swzjb='1' then '重点'
        else '一般' end sz_swzjb,
        case when sz_swzlx='1' then '气泡式'
        when sz_swzlx='2' then '雷达式'
        else '其他' end sz_swzlx ,
        case when sz_swjz='1' then '1985国家高程'
        when sz_swjz='2' then '1956黄海高程'
        when sz_swjz='3' then '吴淞高程'
        else '其他' end sz_swjz
        ,
        bzxx,
        sshd_id,
        ssjg_id,
        sfzx,
        case when  sz_sqzlx='1'  then '雨量站'
        when sz_sqzlx='2'  then '水位站'
        when sz_sqzlx='3'  then '潮位站'
        when sz_sqzlx='4'  then '流量站'
        else '其他' end sz_sqzlx,
        case when  sz_sdjz='1' then '航行基准面'
        else '理论最低潮面' end sz_sdjz ,
        gcjzz,
        sdjzz,
        dswyjz,
        gswyjz,
        yjfs,
        if_add_flag,
        bfyjz from search_sz_swz
  where  scbj='0'
"""

var WaterStation =  db.ais.camel().select(WaterStationSql);

var earthRadius = 6371000;
for(item in WaterStation){
    //4326大地坐标系转墨卡托投影坐标
    var x;
    var y;
    var lat = item.get("zbwd") :: double;//维度
    var lon = item.get("zbjd") :: double;//经度
    
    x = earthRadius * Math.toRadians(lon) :: double;
    y = (earthRadius * Math.log(Math.tan(Math.PI / 4 + Math.toRadians(lat) / 2))) :: double;
    item.put("x",x);
    item.put("y",y);
}



return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: WaterStation
});