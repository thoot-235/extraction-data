import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;

//获取方搜的点位信息
var fsListSql = """
    select point_lon_lat from chais.cockpit_squa_search_point where id = #{code}
"""
var fsList = db.ais.selectValue(fsListSql);
fsList = fsList::string;
fsList = fsList.replace(" ","").replace(","," ").replace("[","").replace("]","").replace("，",",")  
        
var Sql = """
select count(*) OVER() total_count ,
        id,
        cjsj,
        gxsj,
        sjly,
        scbj,
        px,
        swzmc,--水位站名称
        zbjd,--经度
        zbwd,--纬度
        case when hd_hdly='1' then '上游'
        when hd_hdly='2' then '中游'
        else '下游' end hd_hdly ,
        lcwz,
        qyzt,
        dtxz,
        ty_sjsbfs,
        lrmsfjxx,
        case when sz_swzjb='1' then '重点'
        else '一般' end sz_swzjb,
        case when sz_swzlx='1' then '气泡式'
        when sz_swzlx='2' then '雷达式'
        else '其他' end sz_swzlx ,
        case when sz_swjz='1' then '1985国家高程'
        when sz_swjz='2' then '1956黄海高程'
        when sz_swjz='3' then '吴淞高程'
        else '其他' end sz_swjz
        ,
        bzxx,
        sshd_id,
        ssjg_id,
        sfzx,
        case when  sz_sqzlx='1'  then '雨量站'
        when sz_sqzlx='2'  then '水位站'
        when sz_sqzlx='3'  then '潮位站'
        when sz_sqzlx='4'  then '流量站'
        else '其他' end sz_sqzlx,
        case when  sz_sdjz='1' then '航行基准面'
        else '理论最低潮面' end sz_sdjz ,
        gcjzz,
        sdjzz,
        dswyjz,
        gswyjz,
        yjfs,
        if_add_flag,
        bfyjz from search_sz_swz
     where
           scbj='0' and qyzt = '1'
        and   
        public.ST_Contains(
public.st_geometryfromtext ('polygon (("""+fsList+"""))',4326) ,
public.st_geometryfromtext (concat('POINT (',zbjd,' ',zbwd,')'),4326)    
)
?{swzmc, and b.swzmc like  '%'||#{swzmc}||'%' }
""";


var list=db.ais.camel().select(Sql);
var totalCount=0;



if(list==null){
   list=[];
} 
for(item in list){ 
    totalCount = item.get("totalCount");
}     
var back={
        "records":list,
        "total":Integer.parseInt(totalCount::string)
}

import response;
return response.json({
    code: 200,
    success: "查询成功",
    data: back 

});
