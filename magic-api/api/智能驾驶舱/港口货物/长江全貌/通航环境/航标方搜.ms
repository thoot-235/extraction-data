import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
//获取方搜的点位信息
var fsListSql = """
    select point_lon_lat from chais.cockpit_squa_search_point where id = #{code}
"""
var fsList = db.ais.selectValue(fsListSql);
fsList = fsList::string;
fsList = fsList.replace(" ","").replace(","," ").replace("[","").replace("]","").replace("，",",")

log.info("fsList-------------"+fsList);
        
var Sql = """
      select count(*) OVER() total_count,id,hbmc,jdzbjd longitude, jdzbwd latitude ,
SSHD_ID,
case when HB_BTLX='1' then '浮标'
     when HB_BTLX='2' then '岸标'
     else '其他' end HB_BTLX,--标体类型
case when ZSBZ='1' then '专设'
when  ZSBZ='0' then '非专设'
  else '其他' end ZSBZ,--专设标志
case when HB_HBXZ='1' then '锥形'
  when HB_HBXZ='2' then '柱形'
  when HB_HBXZ='3' then '杆形'
  when HB_HBXZ='4' then '塔形'
  when HB_HBXZ='5' then '罐形'
  when HB_HBXZ='6' then '截锥形'  
  when HB_HBXZ='7' then '正方形' 
  when HB_HBXZ='8' then '圆形' 
  when HB_HBXZ='9' then '菱型'  
  when HB_HBXZ='10' then '灯船' 
 when HB_HBXZ='11' then '浮舟' end   HB_HBXZ,--航标形状 
 hb_color
from  postgis.hb_hbjcxx
  where  SCBJ='0'
  and hb_color in ('黄','红','白')
  and hb_sbzt in ('2','4')
  and       public.ST_Contains(
public.st_geometryfromtext ('polygon (("""+fsList+"""))',4326) ,
public.st_geometryfromtext (concat('POINT (',jdzbjd,' ',jdzbwd,')'),4326)    
)
        ?{hbmc,  and hbmc like  '%'||#{hbmc}||'%' }
        """;
//现场数据源为ais 模式为postgis
var list=db.ais.camel().select(Sql);
var totalCount=0;
if(list==null){
   list=[];
} 
for(item in list){ 
    totalCount = item.get("totalCount");
}     
var back={
        "records":list,
        "total":Integer.parseInt(totalCount::string)
}

import response;
return response.json({
    code: 200,
    success: "查询成功",
    data: back 

});