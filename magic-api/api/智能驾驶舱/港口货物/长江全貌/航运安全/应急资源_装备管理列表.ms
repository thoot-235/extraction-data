//装备管理  装备名称、装备编码、所属单位、主要用途
var zbSql = """
    select equip_name, equip_code, admin_unit, main_purpose
      from yjzy_data.yjxx_chxtsssb
    where scbj = '0' and equip_code is not null
      and header = 'chxt' order by id
"""

var list = db.ods_data.camel().page(zbSql,size,(page-1)*size);

import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          result: list
  });