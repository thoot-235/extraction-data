import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;

var sql = """
  select orders,indexcode,name from dict_data.HIKVISION_CCTV_DATA_131 where orders not in ('102','103','104','105','106','107','108','109','110','111') order by orders
"""
var sxbxSql = """
  select orders,indexcode,substr(name,5,3) as name from dict_data.HIKVISION_CCTV_DATA_131 where orders in ('102','103','104','105','106') order by orders
"""
var sxnxSql = """
  select orders,indexcode,substr(name,5,3) as name from dict_data.HIKVISION_CCTV_DATA_131 where orders in ('107','108','109','110','111') order by orders
"""

var list = [];
if(type == "sxbx"){
  list = db.ods_data.camel().select(sxbxSql);
}else if(type == "sxnx"){
  list = db.ods_data.camel().select(sxnxSql);
}else{
  list = db.ods_data.camel().select(sql);
  for(item in list){
    var orders = item.get("orders");
    if(orders == "22"){
      item.put("orders","sxbx");
    }else if(orders == "23"){
      item.put("orders","sxnx");
    }
 }
}




return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: list
});