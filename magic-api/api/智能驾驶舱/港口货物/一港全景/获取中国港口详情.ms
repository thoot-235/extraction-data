import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;


var Sql = """
            select distinct id ,
                gkdm,
                gkzwmc,
                gkywmc,
                gj,
                hx,
                gjywmc,
                js,
                lon,
                lat,
                country_code
            from SEARCH_GK_QQGKQD b
            where 1 = 1
            and b.gj = '中国'
            and b.gkzwmc like '%'||#{portName}||'%' 
        """;
var list = db.ais.camel().select(Sql);
if (list == null || list == '') {
    list = [];
}

return response.json({
    code: 200,
    success: "查询成功",
    data: list
});