import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;
//自年初累计 ym >= concat(to_char(current_date,  'YYYY'),'-01')
//近一年ym >= to_char(date_trunc('month', current_date - interval '1 year'),  'YYYY-MM')
//							    and ym <= to_char(date_trunc('month', current_date - interval '1 month'), 'YYYY-MM')
//greenplum存储过程：proc_sts_cargo_prov14
//粮食 1100 万吨  分14省市
var lsSql = """
    select a.item_name_cn_short as prov_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.dict_river_province a
    left join (select province_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by province_name) b
        on a.item_name_cn = b.province_name
        where  a.item_name_cn_short not in ('山东','河南','陕西')
    order by a.orders;
"""
var lsSumSql="""

"""
//煤炭及制品 0100 万吨   分14省市
var mtSql = """
    select a.item_name_cn_short as prov_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.dict_river_province a
    left join (select province_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                and cargo_type_code = '0100'
                group by province_name) b
        on a.item_name_cn = b.province_name
        where  a.item_name_cn_short not in ('山东','河南','陕西')
    order by a.orders;
"""

//石油、天然气及制品 原油 0200 0201  万吨  分14省市
var sySql = """
    select a.item_name_cn_short as prov_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.dict_river_province a
    left join (select province_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by province_name) b
        on a.item_name_cn = b.province_name
        where  a.item_name_cn_short not in ('山东','河南','陕西')
    order by a.orders;
"""

//金属矿石  0300 万吨  分14省市
var jsSql = """
    select a.item_name_cn_short as prov_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.dict_river_province a
    left join (select province_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by province_name) b
        on a.item_name_cn = b.province_name
        where  a.item_name_cn_short not in ('山东','河南','陕西')
    order by a.orders;
"""

//集装箱货运量 1900 万吨  分14省市
//1800 万TEU
var jzxSql = """
    select a.item_name_cn_short as prov_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.dict_river_province a
    left join (select province_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                and cargo_type_code = '1800'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by province_name) b
        on a.item_name_cn = b.province_name
        where  a.item_name_cn_short not in ('山东','河南','陕西')
    order by a.orders;
"""
//分月统计近一年 万吨
var yearSql = """
    select ym, to_char(coalesce(sum(port_cargo_nums),0)/10000,'9999999999.99') as num
        from ch.sts_cargo_prov14
        where ym >= concat(to_char(current_date,  'YYYY'),'-01')
            group by ym
            order by ym;
"""
//粮食 1100 万吨  分27个重点港口（按照港口所在城市统计）
var ls27Sql = """
    select a.port_cn_name as port_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.d_cb_port_imp a
    left join (select city_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by city_name) b
        on a.city_name = b.city_name
    order by a.orders desc;
"""
//煤炭及制品 0100 万吨  分27个重点港口（按照港口所在城市统计）
var mt27Sql = """
    select a.port_cn_name as port_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.d_cb_port_imp a
    left join (select city_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                and cargo_type_code = '0100'
                group by city_name) b
        on a.city_name = b.city_name
    order by a.orders desc;
"""
//石油、天然气及制品 原油 0200 0201  万吨   分27个重点港口（按照港口所在城市统计）
var sy27Sql = """
    select a.port_cn_name as port_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.d_cb_port_imp a
    left join (select city_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by city_name) b
        on a.city_name = b.city_name
    order by a.orders desc;
"""
//金属矿石  0300 万吨  分27个重点港口（按照港口所在城市统计）
var js27Sql = """
    select a.port_cn_name as port_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.d_cb_port_imp a
    left join (select city_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                --and cargo_type_code = '1900'
                                --and cargo_type_code = '1100'
                                and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by city_name) b
        on a.city_name = b.city_name
    order by a.orders desc;
"""

//集装箱货运量 1900 万吨  分27个重点港口（按照港口所在城市统计）
//1800 万TEU
var jzx27Sql = """
    select a.port_cn_name as port_name, to_char(coalesce(b.nums,0)/10000,'9999999999.99') as num
    from ch.d_cb_port_imp a
    left join (select city_name, sum(port_cargo_nums) nums
                from ch.sts_cargo_prov14
                where ym >= concat(to_char(current_date,  'YYYY'),'-01')
                                and cargo_type_code = '1800'
                                --and cargo_type_code = '1100'
                                --and cargo_type_code = '0300'
                                --and cargo_type_code in ('0200','0201')
                                --and cargo_type_code = '0100'
                group by city_name) b
        on a.city_name = b.city_name
    order by a.orders desc;
"""
//自年初分货类统计总量数据
var zlSql="""
SELECT CASE
         WHEN cargo_type_name = '煤炭及制品' THEN
          '煤炭'
         WHEN cargo_type_name = '金属矿石' THEN
          '铁矿石'
         WHEN cargo_type_name = '集装箱运量(TEU)' THEN
          '集装箱货运量'
         ELSE
          cargo_type_name
       END AS  prov_name,
       to_char(COALESCE(SUM(T.port_cargo_nums) / 10000), '9999999999.99') AS num
  FROM ch.sts_cargo_prov14 T
 WHERE ym >= concat(to_char(CURRENT_DATE, 'YYYY'), '-01')
   AND cargo_type_code IN ('1100', '0100', '0300', '1800')
   AND province_name IN (SELECT item_name_cn
                           FROM ch.dict_river_province
                          WHERE orders <= '11'
                          ORDER BY orders)
 GROUP BY cargo_type_code, cargo_type_name
UNION
SELECT '石油' AS prov_name,
       to_char(COALESCE(SUM(T.port_cargo_nums) / 10000), '9999999999.99') AS num
  FROM ch.sts_cargo_prov14 T
 WHERE ym >= concat(to_char(CURRENT_DATE, 'YYYY'), '-01')
   AND province_name IN (SELECT item_name_cn
                           FROM ch.dict_river_province
                          WHERE orders <= '11'
                          ORDER BY orders)
   AND cargo_type_code IN ('0200', '0201')
"""

if(code == 1){  
    var year = db.gpadmin.camel().select(yearSql);
    for(item in year){
        item.put("num",item.get("num")::double);
    }
    return response.json({
            resultCode: 200,
            resultMsg: "查询成功",
            result: year
    });
}else if(code == 3){
    var ls27 = async db.gpadmin.camel().select(ls27Sql);
    var mt27 = async db.gpadmin.camel().select(mt27Sql);
    var sy27 = async db.gpadmin.camel().select(sy27Sql);
    var js27 = async db.gpadmin.camel().select(js27Sql);
    var jzx27 = async db.gpadmin.camel().select(jzx27Sql);

    for(item in ls27.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in mt27.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in sy27.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in js27.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in jzx27.get()){
            item.put("num",item.get("num")::double);
    }

    var res = {};
    res.put("ls",ls27.get());
    res.put("mt",mt27.get());
    res.put("sy",sy27.get());
    res.put("js",js27.get());
    res.put("jzx",jzx27.get());

    return response.json({
            resultCode: 200,
            resultMsg: "查询成功",
            result: res
    });
}else if(code == 2){
    var zl = db.gpadmin.camel().select(zlSql);
    return response.json({
            resultCode: 200,
            resultMsg: "查询成功",
            result: zl
    });
}else{
    var ls = async db.gpadmin.camel().select(lsSql);
    var mt = async db.gpadmin.camel().select(mtSql);
    var sy = async db.gpadmin.camel().select(sySql);
    var js = async db.gpadmin.camel().select(jsSql);
    var jzx = async db.gpadmin.camel().select(jzxSql);
    var zl = async db.gpadmin.camel().select(zlSql);


    for(item in ls.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in mt.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in sy.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in js.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in jzx.get()){
            item.put("num",item.get("num")::double);
    }
    for(item in zl.get()){
            item.put("num",item.get("num")::double);
    }

    var res = {};
    res.put("ls",ls.get());
    res.put("mt",mt.get());
    res.put("sy",sy.get());
    res.put("js",js.get());
    res.put("jzx",jzx.get());
    res.put("zl",zl.get());

    return response.json({
            resultCode: 200,
            resultMsg: "查询成功",
            result: res
    });
}