import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;


//
var shipNumsSql = """
  select port_name_o, port_name_d, line, num
   from dm_data.STS_PORT_FLOW_DIRECTION
  where code_type = '1'
    and import_time = (select max(import_time)
                         from dm_data.STS_PORT_FLOW_DIRECTION
                        where code_type = '1')
"""
var shipNums =  db.dm_data.camel().select(shipNumsSql);
for(item in shipNums){
item.put("num",item.get("num")::double);
}

return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: shipNums
});