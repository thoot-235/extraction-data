var sql = """
    select CASE_NO,
       ILLEGAL_FACT,
       PUNISH_RESULT,
       case when to_char(punish_date, 'yyyy-MM-dd')='1900-01-01' then '--' else to_char(punish_date, 'yyyy-MM-dd') end  DECISION_DATE,
       rpad(ORG_CODE,6,0) ORG_CODE,
       ORG_NAME,
       '--' SUIT_COURT
  from BIZ_AP_PUNISH_DECISION
  where delete_flag='0' and case_no in (select case_no from BIZ_AP_ILLEGAL_PARTIES where  delete_flag='0' and object_cate_code  ='1'
  ?{creditCode,and party_cert_no  = #{uscc}})
    order by  punish_date desc
    """
var basic = db.biz_data.camel().page(sql);
if(basic==null||basic.list==null){
  basic={
        "total": 0,
        "list": []
    };
} 
//for(item in basic.list){
  //item.put("orgName",TagUtils.getTagNameByCode("issuOrgTag",item.get("orgCode")));
//}
return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: basic
	});