import request;

companyId = (companyId == null ? "" : companyId).replace("<em>", "").replace("</em>", "");
uscc = (uscc == null ? " " : uscc).replace("<em>", "").replace("</em>", "");
companyName = (companyName == null ? " " : companyName).replace("<em>", "").replace("</em>", "");
if ((companyId == null || companyId.toString().equals("")) && (uscc == null || uscc.toString().equals("")) && (companyName == null || companyName.toString().equals(""))) {
    return response.json({
        resultCode: 500,
        resultMsg: "统一社会信用代码或组织机构不能同时为空"
    });
}

var fieldsPowerSql = """ select listagg(column_en,',')  within group 
                            (order by table_name_en)  as "colum" from bds_base_data.sc_table_fields 
                                where table_name_en='BDS_BASE_DATA.COMPANY_INFO_ALL'""";
var fieldsPower = db.base_data.selectOne(fieldsPowerSql); //字段权限控制
var sql1 = """
  
  SELECT id, ORGANIZATION_CODE COMPANYID,
       COMPANY_NAME,
       ORGANIZATION_CODE,
       case  when TO_CHAR(REG_DATE, 'yyyy-MM-dd')='1900-01-01' then '--'  else TO_CHAR(REG_DATE, 'yyyy-MM-dd') end  REG_DATE,
       LEGAL_REPRESENTATIVE,
       REGCAPITAL,
       COMPANY_REG_ADDR ADDRESS,
       CONTACT_PERSON,
       MOBILE_PHONE,
       MAILING_ADDRESS,
       FAX,
       USCC,
       WEB_SITE,
       COMPANY_TYPE NATURE_CODE,
       TRANS_LIC_NO BUSINESS_NO,      
       TRANS_SERV_LIC_NO LICENSE_NO,
       MANAGE_NO,
       PORT_LICENSE_NO,
       IF_OBTAIN,
       case when to_char(OBTAIN_DATE,'yyyy-MM-dd')='1900-01-01' then '--' else to_char(OBTAIN_DATE,'yyyy-MM-dd') end  OBTAIN_DATE,
       INTER_CERT_NO,
       INTER_LICENSE_CODE,
       INTER_SHIP_LICENSE_CODE,
       COMPANY_OPERATE_SCOP,
       AUTHORITY,
       OPENTIME,REGCODE,QUALIFICATION,PAIDINCAPITAL,DISTRICT,COMPANY_REG_ADDR,COMPANY_OPERATE_ADDR,COMPANY_OPERATE_SCOP,OPEN_STATUS,COMPANY_TYPE_CODE,INDUSTRY,OPENTIME,AUTHORITY,IF_GET_DOC,OFFICE_TELEPHONE,WE_CHAT,CONTACT_PERSON_DUTY,REGCAPITAL,CONTACT_ADDRESS,ANNUALDATE,SAFETY_LEVEL,EMAIL
  from BDS_BASE_DATA.company_info_all
  <trim prefix="WHERE" prefixOverrides="AND |OR ">
       <if test="companyId != null and companyId!=''">
             OR ORGANIZATION_CODE = #{companyId}
      </if>
      <if test="uscc != null and uscc!=''">
             OR uscc = #{uscc}
      </if>
      <if test="companyName != null and companyName!=''">
             OR company_name = #{companyName}
      </if>
     
  </trim>
 
"""
var sqlCount = "select " + fieldsPower.get("colum") + """ from BDS_BASE_DATA.company_info_all
 　<trim prefix="WHERE" prefixOverrides="AND |OR ">
       <if test="companyId != null and companyId!=''">
             OR ORGANIZATION_CODE = #{companyId}
      </if>
      <if test="uscc != null and uscc!=''">
             OR uscc = #{uscc}
      </if>
      <if test="companyName != null and companyName!=''">
             OR company_name = #{companyName}
      </if>
     
  </trim>
   """;


var basic = db.base_data.camel().selectOne(sql1);

var sqlCountData = db.base_data.camel().selectOne(sqlCount);
var perfection;
//计算空值率
if (sqlCountData != null) {
    var total = 0;
    var notEmpty = 0;
    sqlCountData.forEach((k, v) -> {
        ++total;
        if (v != null && v != '') {
            ++notEmpty;
        }
    });
    perfection = String.format("%.2f", (Double.parseDouble(notEmpty.toString()) / Double.parseDouble(total.toString())) * 100) + "%";
    //log.info("空值率==="+Integer.parseInt(total.toString())+"个"+Integer.parseInt(notEmpty.toString())+"个" 
    //+String.format("%.2f",(Double.parseDouble(notEmpty.toString())/Double.parseDouble(total.toString()))*100)+"%")
}

var crediSql = """select CREDI_RYB_FLAG,CREDI_SX_FLAG,CREDI_CH_FLAG from  BDS_BASE_DATA.company_info_all
  where 1=1  ?{companyId,and ORGANIZATION_CODE = #{companyId}}"""

var basicCredi = db.base_data.camel().selectOne(crediSql);


if (basic != null && basic != {}) {
       basic.put("_uscc",ZzSecurityHelper.encryptAES(basic.get("uscc")));
       basic.put("_companyName",ZzSecurityHelper.encryptAES(basic.get("companyName")));
    if (basicCredi != null) {
        basic.put("credi_ryb_flag", basicCredi.get("crediRybFlag"));
        basic.put("credi_ch_flag", basicCredi.get("crediChFlag"));
        basic.put("credi_sx_flag", basicCredi.get("crediSxFlag"));

    } else {
        basic.put("credi_ryb_flag", "");
        basic.put("credi_ch_flag", "");
        basic.put("credi_sx_flag", "");
    }

    basic.put("natureName", TagUtils.getTagNameByCode("natureEnterpriseTag", basic.get("natureCode") == null ? "" : basic.get("natureCode")::string));
    basic.put("ifObtainCn", TagUtils.getTagNameByCode("obtainMarkTag", basic.get("ifObtain") == null ? "" : basic.get("ifObtain")::string)); //是否取得标准化证书
    basic.put("_mobilePhone", DesensitizationUtil.isFixed(basic.get("mobilePhone") == null ? "" : basic.get("mobilePhone")::string));
    basic.put("_fax", DesensitizationUtil.isFixed(basic.get("fax") == null ? "" : basic.get("fax").asString()));
    basic.put("_mailingAddress", DesensitizationUtil.email(basic.get("mailingAddress") == null ? "" : basic.get("mailingAddress")::string));

    basic.put("companyTypeCode", TagUtils.getTagNameByCode("companyTypeTag", basic.get("companyTypeCode")));
    basic.put("ifGetDoc", TagUtils.getTagNameByCode("isOrNotTag", basic.get("ifGetDoc")));

}


