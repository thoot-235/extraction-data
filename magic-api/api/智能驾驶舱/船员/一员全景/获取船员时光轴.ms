import org.springblade.common.utils.ZzSecurityHelper
import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import 'org.springblade.common.utils.DesensitizationUtil' as DesensitizationUtil;
import log;
import response;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
var idCardNo = (body.idCardNo == null ? "" : body.idCardNo).replace("<em>", "").replace("</em>", "");
if(idCardNo==null || idCardNo ==""){
    return response.json({
        resultCode: 200,
        resultMsg: "idCardNo不能为空"
    });
}
log.info("------------------------idCardNo---------------------------"+idCardNo);
idCardNo = ZzSecurityHelper.decryptAES(idCardNo);
var sql1 = """
   select distinct ID, to_char(START_DATE,'yyyy"年"mm"月"dd"日"') START_DATE, to_char(END_DATE,'yyyy"年"mm"月"dd"日"') END_DATE, EVENT_CONTENT, POST, NAME, ID_CARD_NO,
        to_char(CERATE_TIME,'yyyy-mm-dd') CERATE_TIME, to_char(UPDATE_TIME,'yyyy-mm-dd')  UPDATE_TIME
        from CREW_TIMELINE
        where 1=1
        ?{idCardNo, and  ID_CARD_NO = #{idCardNo}} 
        ?{startTime, and START_DATE >= to_date(#{startTime},'yyyy-mm-dd')} 
        ?{startTime, and START_DATE <= to_date(#{endTime},'yyyy-mm-dd')} 
        order by START_DATE desc
"""
var sql2 = """
   select distinct POST
        from CREW_TIMELINE
        where 1=1
         ?{idCardNo, and  ID_CARD_NO = #{idCardNo}} 
         order by post desc
"""

var ret = db.dm_data.camel().select(sql1);
var postList = db.dm_data.camel().select(sql2);
log.info(postList.size() + '-----------');
//创建最终职务列表
var resultList = [];
//将可以转码的职务存储进最终合集
for (item in postList) {
    if ("1000".equals(item.get("post"))) {
        resultList.add("培训");
    } else if ("990".equals(item.get("post"))) {
        resultList.add("注册");
    } else {
        var post = TagUtils.getTagNameByCode("offiDutyTag", item.get("post"));
        Pattern pt = Pattern.compile("[\u4e00-\u9fa5]");
        Matcher m = pt.matcher(post);
        if (m.find()) {
            resultList.add(post);
        }
    }
}

var res = {};
res.put("post", resultList);
for (item in ret) {
     var eventContent = String.valueOf(item.get("eventContent").replace("【】", "").replace(",培训证明编号为。", "。"));
    // eventContent = eventContent.substring(eventContent.indexOf(startDate))
     var k=eventContent.indexOf("证书编号为【");
     var first;
     var last;
     var cerNo;
     var cerNoLater;
     if(k>=1){
              first=eventContent.substring(0,    Integer.parseInt(k.toString()))
              last=eventContent.substring(Integer.parseInt(k.toString())+6,    eventContent.length())
              if(last.indexOf("】")>=1){
                       cerNo=DesensitizationUtil.certNo(last.substring(0,last.indexOf("】")));
                       cerNoLater=last.substring(last.indexOf("】"),last.length())
                       last=cerNo+cerNoLater;
              }
              eventContent=first+"证书编号为【"+last;
               
     }
    var startDate = String.valueOf(item.get("startDate"));
    item.put("eventContent", eventContent.substring(eventContent.indexOf(startDate) + startDate.length() + 1));
}
res.put("list", ret);
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    result: res
});