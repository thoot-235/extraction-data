  "responseBody" : "{\n    \"resultCode\": 200,\n    \"resultMsg\": \"查询成功\",\n    \"data\": {\n        \"list\": [{\n            \"rowno\": \"4\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国大气污染防治法》第一百零六条的规定\",\n            \"orgName\": \"中华人民共和国威海海事局\",\n            \"caseNo\": \"2020050303000311\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"宁波天盛海运有限公司\",\n            \"punishObjAddress\": \"浙江省宁波市镇海区环城西路261号\",\n            \"illegalFact\": \"2020年1月10日，威海新港海事处执法人员对威海新港15泊的宁波天盛海运有限公司所属的中国籍国际航行的散货船”天盛26”轮进行现场监督检查，该轮在威海港装载碎石。执法人员在主机滤器位置对该轮靠港后正在使用的燃油进行取样，快检设备检测出样品含硫量约为0.66%m/m，经第三方检测机构进一步检测， 油样含硫量为0.6092%m/m，不符合大气污染物控制要求。远洋船舶“天盛26”轮靠港后未使用符合大气污染物控制要求的船舶用燃油，违反《中华人民共和国大气污染防治法》第六十三条第一款规定。\",\n            \"punishResult\": \"罚款人民币叁万伍仟元整\",\n            \"orgCode\": \"0102020502060203\",\n            \"deliveryDate\": \"2020-01-17\",\n            \"creatorName\": \"程浩栋\",\n            \"createTime\": \"2020-01-17 11:51:12\",\n            \"decisionDate\": \"2020-01-17\"\n        }, {\n            \"rowno\": \"7\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国海上海事行政处罚规定》第二十四条第一款、第二款第（十一）项、《中华人民共和国海上交通安全法》第九条、;\",\n            \"orgName\": \"广州沙角海事处\",\n            \"caseNo\": \"2019090107111111\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"马二强\",\n            \"punishObjAddress\": \"西安市周至县\",\n            \"illegalFact\": \"“天盛26”不按照规定守听航行通信(代码101011)，宁波天盛海运有限公司经营、马二强任三副的“天盛26”船，2019年10月10日抵达7SM锚地待命，2019年10月28日0945时左右沙角海事处执法人员现场巡航时在高频对其呼叫，无人应答。\",\n            \"punishResult\": \"罚款人民币贰仟元整\",\n            \"orgCode\": \"0102020902030204\",\n            \"deliveryDate\": \"2019-11-12\",\n            \"creatorName\": \"隋永超\",\n            \"createTime\": \"2019-11-12 15:36:00\",\n            \"decisionDate\": \"2019-11-12\"\n        }, {\n            \"rowno\": \"5\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国海上海事行政处罚规定》第三十四条第一款、《港口建设费征收使用管理办法》第十条、《港口建设费征收使用管理办法》第九条、《港口建设费征收使用管理办法》第八条、《港口建设费征收使用管理办法》第十一条、《港口建设费征收使用管理办法》第十二条、;\",\n            \"orgName\": \"广州沙角海事处\",\n            \"caseNo\": \"2019090107111211\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"张冠文\",\n            \"punishObjAddress\": \"广东省东莞市麻涌镇\",\n            \"illegalFact\": \"“天盛26”不按规定缴纳或少缴纳港口建设费(代码103001)，宁波天盛海运有限公司所有、苏若飞任船长的“天盛26”船，2019年10月6日0400时从台湾海峡附近水域前往广州，于2019年11月8日经广州沙角海事处执法人员检查发现该船本航次货物的港口建设费申报手续是由张冠文负责办理的，该船本航次没有依法办理港口建设费相关手续以及减免缓征申请，该船不按规定缴纳或少缴纳港口建设费。\",\n            \"punishResult\": \"罚款人民币伍仟元整\",\n            \"orgCode\": \"0102020902030204\",\n            \"deliveryDate\": \"2019-11-12\",\n            \"creatorName\": \"赵晓彪\",\n            \"createTime\": \"2019-11-12 15:59:00\",\n            \"decisionDate\": \"2019-11-12\"\n        }, {\n            \"rowno\": \"1\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国船舶安全监督规则》第五十三条第二款、《中华人民共和国船舶安全监督规则》第十一条、《中华人民共和国船舶安全监督规则》第十条、《中华人民共和国海上交通安全法》第十二条、;\",\n            \"orgName\": \"广州沙角海事处\",\n            \"caseNo\": \"2019090107111311\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"宁波天盛海运有限公司\",\n            \"punishObjAddress\": \"宁波市镇海区环城西路261号\",\n            \"illegalFact\": \"“天盛26”中国籍国内航行船舶进出港口不按照规定报告（未按规定时间报告）(代码102005-1)，宁波天盛海运有限公司所有、苏若飞任船长的“天盛26”船，2019年10月6日0400时从台湾海峡附近水域前往广州，于2019年11月8日经广州沙角海事处执法人员检查发现该船在台湾海峡附近水域装货后航至广州的航次未向海事主管机关报告，该船舶进出港口不按照规定报告。\",\n            \"punishResult\": \"罚款人民币捌仟元整\",\n            \"orgCode\": \"0102020902030204\",\n            \"deliveryDate\": \"2019-11-12\",\n            \"creatorName\": \"赵晓彪\",\n            \"createTime\": \"2019-11-12 15:52:00\",\n            \"decisionDate\": \"2019-11-12\"\n        }, {\n            \"rowno\": \"2\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"1、《防治船舶污染海洋环境管理条例》第五十八条第（三）项，2、《中华人民共和国海洋环境保护法》第七十三条第一款第（一）项及第二款、《中华人民共和国海上海事行政处罚规定》第五十四条第一款第（一）项及第二款\",\n            \"orgName\": \"中华人民共和国宝山海事局\",\n            \"caseNo\": \"2019010800054511\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"宁波天盛海运有限公司\",\n            \"punishObjAddress\": \"浙江省宁波市镇海区环城西路261号\",\n            \"illegalFact\": \"宁波天盛海运有限公司所经营的“天盛26”，于2019年08月05日10:30时，在石洞口华能电厂被执法人员发现：该船于2018年07月10日在30°42.9N，123°01.0E排放0.04m³食品废弃物入海，船舶向海域排放禁止排放的污染物，其行为违反了《防治船舶污染海洋环境管理条例》第十五条第一款的规定。\",\n            \"punishResult\": \"罚款人民币叁万伍仟元整\",\n            \"orgCode\": \"010202010207\",\n            \"deliveryDate\": \"2019-09-17\",\n            \"creatorName\": \"陈晨\",\n            \"createTime\": \"2019-09-17 13:33:58\",\n            \"decisionDate\": \"2019-09-17\"\n        }, {\n            \"rowno\": \"3\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国船员条例》第五十六条第（四）项\",\n            \"orgName\": \"中华人民共和国连云港海事局\",\n            \"caseNo\": \"2019170600003211\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"王其波\",\n            \"punishObjAddress\": \"浙江舟山定海区城东街道颜家峡路25号\",\n            \"illegalFact\": \"2019年5月6日1300时，连云港海事局执法人员对连云港102泊位“天盛26”检查时发现，该轮本航次于2019年4月25日1905时从广州出发，于2019年5月5日1736时靠泊连云港102泊位，经查该轮本航次4月 26日至4月30日前往台湾海峡过驳装运海砂，为隐瞒违规载运海砂的事实，《航海日志》未如实记载在台湾海峡过驳作业的信息，仅记载为锚泊。又查该轮货物载运单上显示本航次从漳州起运海砂，但《航海日志》中却无在漳州停靠作业记录。该轮上述行为构成了未如实记载有关船舶法定文书的事实，船长王其波作为文书审核人，违反了《中华人民共和国船员条例》第二十条第（三）项之规定。\",\n            \"punishResult\": \"罚款人民币肆仟元整\",\n            \"orgCode\": \"010202170305\",\n            \"deliveryDate\": \"2019-06-26\",\n            \"creatorName\": \"祁伟\",\n            \"createTime\": \"2019-06-26 13:53:52\",\n            \"decisionDate\": \"2019-06-26\"\n        }, {\n            \"rowno\": \"6\",\n            \"totalCount\": \"7\",\n            \"punishReference\": \"《中华人民共和国船舶安全监督规则》第五十三条第二款《中华人民共和国海上海事行政处罚规定》第九条第一款第（二）项\",\n            \"orgName\": \"舟山沈家门海事处\",\n            \"caseNo\": \"2019070302021311\",\n            \"caseStatus\": \"已完成\",\n            \"processType\": \"fine\",\n            \"processTypeName\": \"罚款(元)\",\n            \"punishObjName\": \"宁波天盛海运有限公司\",\n            \"punishObjAddress\": \"浙江省宁波市镇海区环城西路261号\",\n            \"illegalFact\": \"2019年2月25日0900时，舟山六横海事执法人员对“天盛26”船网上进出港申报核查时发现：“天盛26” 船于2019年2月22日2150时提交进港报告（申报单号DZQZ201903839623），拟于2月23日0205时靠泊六横涨起港码头。于2019年2月23日0113时提交出港报告（申报单号DZQZ201903844715）,拟于2月23日0502时从六横涨起港码头离泊，下一港南沙。执法人员调取该船AIS轨迹发现，该船在上述期间未停靠过该码头。该船未按照规定向海事管理机构报告船舶进出港信息，违反了《中华人民共和国海上交通安全法》第十二条第二款和《中华人民共和国船舶安全监督规则》第十条、第十一条的规定。另据调查，“天盛26”于2018年9月18日因同一违法行为在台州玉环海事处被处罚过，行政决定书【2018】0705020225，现对其从重处罚。\",\n            \"punishResult\": \"罚款人民币壹万伍仟元整\",\n            \"orgCode\": \"0102020702020201\",\n            \"deliveryDate\": \"2019-03-19\",\n            \"creatorName\": \"诸葛奕东\",\n            \"createTime\": \"2019-03-19 09:08:30\",\n            \"decisionDate\": \"2019-03-19\"\n        }],\n        \"total\": 7\n    }\n}",
