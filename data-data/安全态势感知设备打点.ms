================================
import response;

var sql="""
select equipment_name,
       units_involved,
       address,
       specific_address,
       equipment_model,
       equipment_sn,
       to_char(round(lon,6),'FM999999990.000000') as lon,
       to_char(round(lat,6),'FM999999990.000000') as lat
  from situation_awareness_360 t where 1=1 
?{unitsInvolved,and t.units_involved like  '%'||#{unitsInvolved}||'%'}
?{address,and t.address like  '%'||#{address}||'%'}
"""
var list=db.hs_share.camel().select(sql);
if (list == null) {
    list = [];
}
return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});