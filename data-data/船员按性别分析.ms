import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;

var Sql = """
select target_name sex, target_val num
  from dm_data.sts_basic_info
 where sts_code = '04' and to_char(sts_date,'yyyy-MM-dd') = to_char(sysdate,'yyyy-MM-dd')
 order by target_name desc
        """;
var list = db.dm_data.camel().select(Sql);
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: list
});