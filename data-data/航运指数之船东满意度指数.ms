        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 1) type
          from (select extract(year from sysdate) - 3 year from dual) a0
          left join (select year, tjvalue, type
