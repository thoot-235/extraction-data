import lombok.experimental.var
import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;
import java.util.Random;

var second = qaIndexNameSecond != null && qaIndexNameSecond != '' ? qaIndexNameSecond : '航道建设服务';
var Sql = """select year,
       sy,
       zy,
       xy,
       type,
       case
         when type = '1' then
          year || '上半年'
         when type = '2' then
          year || '下半年'
       end time
  from (select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 1) type
          from (select extract(year from sysdate) year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '1') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
                       and t.type = '1') a2
            on a0.year = a2.year
           and a1.type = a2.type
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'xy'
                       and t.type = '1') a3
            on a0.year = a3.year
           and a2.type = a3.type
        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 2) type
          from (select extract(year from sysdate) year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '2') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
                       and t.type = '2') a2
            on a0.year = a2.year
           and a1.type = a2.type
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'xy'
                       and t.type = '2') a3
            on a0.year = a3.year
           and a2.type = a3.type
        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 1) type
          from (select extract(year from sysdate) - 1 year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '1') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
                       and t.type = '1') a2
            on a0.year = a2.year
           and a1.type = a2.type
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'xy'
                       and t.type = '1') a3
            on a0.year = a3.year
           and a2.type = a3.type
        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 2) type
          from (select extract(year from sysdate) - 1 year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '2') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
                       and t.type = '2') a2
            on a0.year = a2.year
           and a1.type = a2.type
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'xy'
                       and t.type = '2') a3
            on a0.year = a3.year
           and a2.type = a3.type
        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 1) type
          from (select extract(year from sysdate) - 2 year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '1') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
                       and t.type = '1') a2
            on a0.year = a2.year
           and a1.type = a2.type
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'xy'
                       and t.type = '1') a3
            on a0.year = a3.year
           and a2.type = a3.type
        union
        select a0.year,
               nvl(a1.tjvalue, 0) sy,
               nvl(a2.tjvalue, 0) zy,
               nvl(a3.tjvalue, 0) xy,
               nvl(a1.type, 2) type
          from (select extract(year from sysdate) - 2 year from dual) a0
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'sy'
                       and t.type = '2') a1
            on a0.year = a1.year
          left join (select year, tjvalue, type
                      from sub_base_data.IDX_QA_ANSWER_RESULT_TJ t
                     where QA_INDEX_NAME_SECOND = #{second}
                       and t.area = 'zy'
