import response;



//事故件数
var accidentSql="""
select  year ,ACCIDENT_NUM as nums from  ods_hs_share.accident_index order by  year
"""
//死亡人数
var deathSql="""
select  year ,DEATH_NUM as nums from  ods_hs_share.accident_index order by  year
"""
//沉船
var wreckSql="""
select  year ,WRECK_NUM as nums  from  ods_hs_share.accident_index order by  year
"""
//直接经济损失

var economicSql="""
select  year ,ECONOMIC_LOSS  as nums from  ods_hs_share.accident_index order by  year
"""

var accidentNum =  db.ods_data.camel().select(accidentSql);
var deathNum =  db.ods_data.camel().select(deathSql);
var wreckNum =  db.ods_data.camel().select(wreckSql);
var economicNum =  db.ods_data.camel().select(economicSql);


var re={};
re.put("accidentNum",accidentNum)
re.put("deathNum",deathNum)
re.put("wreckNum",wreckNum)
re.put("economicNum",economicNum)


return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    result: re
});






