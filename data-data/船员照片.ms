import "java.io.ByteArrayOutputStream" as ByteArrayOutputStream ;
import "javax.servlet.ServletOutputStream" as ServletOutputStream ;
import 'java.awt.image.BufferedImage' as BufferedImage;
import "java.lang.Byte" as Byte;
import "java.sql.Blob" as Blob;
import 'javax.imageio.ImageIO' as ImageIO;
import "java.awt.image.RenderedImage" as RenderedImage;

import 'org.springframework.core.io.ClassPathResource' as ClassPathResource;
import 'java.io.InputStream' as InputStream;

import response;
import 'org.springblade.common.utils.ZzSecurityHelper' as ZzSecurityHelper;


var idCardNo=(body.idCardNo==null?"":body.idCardNo).replace("<em>","").replace("</em>","");
idCardNo=ZzSecurityHelper.decryptAES(body.idCardNo);
idCardNo = idCardNo.replace("<em>","").replace("</em>","");

if(idCardNo==null || idCardNo==''){
    return  response.json({
        "code": 0,
        "message": "参数[idCardNo]为必填项",
        "data": {},      
        "executeTime": 2
    });
}
//idCardNo=(idCardNo==null?"":idCardNo).replace("<em>","").replace("</em>","");

var  sql = """
select * from (
          select tag, photo_info,photo_type,'系统上传照片' as photo_type_cn, CREATING_TIME
              from (select 0 as tag,photo_info,photo_type,to_char(CREATING_TIME, 'yyyy-mm-dd') as CREATING_TIME
                      from bds_base_data.crew_photo
                     where 1=1 ?{idCardNo,and id_card_no = #{idCardNo}}
                       and photo_type = '0'
                       and  delete_flag='0'
                       and VALID_FLAG = '1'
                     order by creating_time desc)
             where rownum = 1
             union all
          select tag,photo_info,photo_type,'身份证照片' as photo_type_cn, CREATING_TIME
              from (select 2 as tag,photo_info,photo_type,to_char(CREATING_TIME, 'yyyy-mm-dd') as CREATING_TIME
                      from bds_base_data.crew_photo
                     where 1=1 ?{idCardNo,and id_card_no = #{idCardNo}}
                       and photo_type = '1'
                         and  delete_flag='0'
                       and VALID_FLAG = '1'
                     order by creating_time desc)
             where rownum = 1
              union all
          select tag,photo_info,photo_type,'公安认证照片' as photo_type_cn , CREATING_TIME
              from (select 1 as tag,photo_info,photo_type,to_char(CREATING_TIME, 'yyyy-mm-dd') as CREATING_TIME
                      from bds_base_data.crew_photo
                     where 1=1 ?{idCardNo,and id_card_no = #{idCardNo}}
                       and photo_type = '2'
                       and VALID_FLAG = '1'
                         and  delete_flag='0'
                     order by creating_time desc)
             where rownum = 1
             )
             order by tag
             
""";
var photoPO=db.base_data.camel().select(sql);
return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: photoPO
	});


            