import response;

var sql ="""
SELECT t1.station_name,
       t2.longitude,
       t2.latitude,
       t1.dvice_no,
       t1.address,
       case when t2.state=2 then '未连接'
         when t2.state=1 then '连接，无数据'
           else '连接，有数据' end as state,
       case when t3.cover_radius > 30 then 30
       else t3.cover_radius end as cover_radius,
       t3.calculate_date,
       t3.max_distance
  FROM ODS_HS_SHARE.AIS_STATION_info t1
  left join dm_data.ais_station_status t2
    on t1.station_name = t2.name
  left join (select *
               from DM_DATA.AIS_STATION_COVER_RADIUS
              where CALCULATE_DATE =
                    (select max(CALCULATE_DATE)
                       from DM_DATA.AIS_STATION_COVER_RADIUS)) t3
    on t2.id = t3.base_station_id
 where 1=1
 ?{stationName,and t1.station_name like  '%'||#{stationName}||'%'}
   and t1.del_flag = '0'
   and t2.longitude is not null
"""

var list=db.hs_share.camel().select(sql);
if (list == null) {
    list = [];
}
return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});