import 'com.success.data.tag.TagUtils' as TagUtils;
import response;
var  sql="""
SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_CB_HOME_PORT 
"""
var homePort=db.ods_data.camel().select(sql);//船籍港


  sql="""SELECT code as value ,ITEM_NAME_en  as value_cn  FROM DICT_DATA.D_CB_FLAG_STATE_CODE 
"""
var cbFlagStateCode=db.ods_data.camel().select(sql);//船旗国  --psc



sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_CB_CBDJ_COUNTRY 
"""
var cbdjCountry=db.ods_data.camel().select(sql);//国籍





sql="""SELECT code as value ,ITEM_NAME_cn  as value_cn  FROM DICT_DATA.D_CB_SHIP_TYPE   where ITEM_NAME_cn is not null

"""
var cbShipType=db.ods_data.camel().select(sql);//船舶安全监督\船舶登记用这个参数字典


sql="""SELECT code as value ,ITEM_NAME_cn  as value_cn  FROM DICT_DATA.D_CB_PSC_SHIP_TYPE
"""
var pscShipType=db.ods_data.camel().select(sql);//psc用这个参数字典--船舶类型



sql="""SELECT code as value ,ITEM_NAME_CN  as value_cn  FROM DICT_DATA.D_CB_HULL_MATERIAL 
"""
var hullMaterial=db.ods_data.camel().select(sql);//船体材料



sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CB_SHIP_ENGINE_TYPE
"""
var shipEngingType=db.ods_data.camel().select(sql);//主机种类


sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CB_PROPELLER_KIND
"""
var propellerKind=db.ods_data.camel().select(sql);//推进器种类


sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CB_SHIP_WIND_LEVEL
"""
var shipWindLevel=db.ods_data.camel().select(sql);//核定抗风等级


sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_CB_SAILINGAREA
"""
var sailingarea=db.ods_data.camel().select(sql);//航区名称




sql="""SELECT  code as value ,ITEM_NAME_CN  as value_cn  FROM dict_data.D_COMM_MARITIME_AGENCY
"""
var maritimeAgency=db.ods_data.camel().select(sql);//航区名称



var data={
    sailingarea:sailingarea,
    shipWindLevel:shipWindLevel,
    homePort:homePort,
    cbFlagStateCode:cbFlagStateCode,
    
    cbdjCountry:cbdjCountry,
    cbShipType:cbShipType,
    pscShipType:pscShipType,

    hullMaterial:hullMaterial,
    shipEngingType:shipEngingType,

    propellerKind:propellerKind,
    maritimeAgency:maritimeAgency


}

return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: data
	});



