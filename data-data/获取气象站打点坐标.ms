import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;
import http;
import java.lang.Math;


var WeatherStationSql = """
  select
            id,
            stationname ,
            longitude ,
            latitude 
        from
            search_dmgd_nws_object
"""

var WeatherStation =  db.ais.camel().select(WeatherStationSql);

var earthRadius = 6371000;
for(item in WeatherStation){
    //4326大地坐标系转墨卡托投影坐标
    var x;
    var y;
    var lat = item.get("latitude") :: double;//维度
    var lon = item.get("longitude") :: double;//经度
    
    x = earthRadius * Math.toRadians(lon) :: double;
    y = (earthRadius * Math.log(Math.tan(Math.PI / 4 + Math.toRadians(lat) / 2))) :: double;
    item.put("x",x);
    item.put("y",y);
}



return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: WeatherStation
});