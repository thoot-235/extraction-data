import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;
//船闸（32：升船机；1：三峡南线；2：三峡北线；4：葛洲坝1#；8：葛洲坝2#；16：葛洲坝3#）
//32：升船机
var scj = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=32 order by serial_number asc
"""

var plan1 =  db.ods_data.camel().select(scj);

//1：三峡南线
var sxnx = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=1 order by serial_number asc
"""

var plan2 =  db.ods_data.camel().select(sxnx);

//2：三峡北线
var sxbx = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=2 order by serial_number asc
"""

var plan3 =  db.ods_data.camel().select(sxbx);

//4：葛洲坝1#
var gzb1 = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=4 order by serial_number asc
"""

var plan4 =  db.ods_data.camel().select(gzb1);

//8：葛洲坝2#
var gzb2 = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=8 order by serial_number asc
"""

var plan5 =  db.ods_data.camel().select(gzb2);

//16：葛洲坝3#
var gzb3 = """
select case when direction=1 then '上' else '下' end direction ,serial_number,display_name,plan_start_time from SANXIA_PLAN WHERE sysdate>= plan_start_time and 
sysdate<=plan_end_time and damgate_id=16 order by serial_number asc
"""

var plan6 =  db.ods_data.camel().select(gzb3);


var data = {};
data.put("scj",plan1);
data.put("sxnx",plan2);
data.put("sxbx",plan3);
data.put("gzb1",plan4);
data.put("gzb2",plan5);
data.put("gzb3",plan6);

return response.json({
    code: 200,
    success: "查询成功",
    result: data 

});