import response;

var sql = """
select 
id,name,gender,age,
employer,contact_organization,
field,position,contact,specialty
from  eoc.ods_yj_river_emergency_experts 
order by id
"""

var list = db.lx_doris.camel().page(sql,size,(page-1)*size);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });