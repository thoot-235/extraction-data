import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import log;
import response;

//自年初累计
var sinceYearSql = """
    select REGEXP_REPLACE(a.item_name_cn,'[省市]','') province_name,
            nvl(b.nums, 0) nums,
            nvl(b.total, 0) total,
            row_number() over(order by total DESC) as row_num
        from dict_data.dict_river_province a
        left join (select province_name, train_stu_num nums, train_stu_total total
                    from dm_data.sts_crew_training
                    where year = to_char(sysdate, 'yyyy')) b
            on a.item_name_cn = b.province_name
        order by a.orders
"""
//近五年
var fiveYearSql = """
    select REGEXP_REPLACE(a.item_name_cn,'[省市]','') province_name,
        nvl(b.nums, 0) nums,
        nvl(b.total, 0) total,
            row_number() over(order by total DESC) as row_num
    from dict_data.dict_river_province a
    left join (select province_name,
                        sum(train_stu_num) nums,
                        sum(train_stu_total) total
                from dm_data.sts_crew_training
                where year >=
                        to_char(add_months(trunc(sysdate, 'year'), -12), 'yyyy')
                        and year < to_char(trunc(sysdate, 'year'), 'yyyy')
                group by province_name) b
        on a.item_name_cn = b.province_name
    order by a.orders
"""

var sinceYear = async db.dm_data.camel().select(sinceYearSql);
var fiveYear = async db.dm_data.camel().select(fiveYearSql);


for(item in sinceYear.get()){
    item.put("nums",item.get("nums")::int);
    item.put("total",item.get("total")::int);
}
for(item in fiveYear.get()){
    item.put("nums",item.get("nums")::int);
    item.put("total",item.get("total")::int);
}

var res = {};
res.put("sinceYear",sinceYear.get());
res.put("fiveYear",fiveYear.get());

return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: res
});