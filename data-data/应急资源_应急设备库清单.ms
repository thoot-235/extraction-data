var yjcbwzSql = """
select * from (
	SELECT
    t.name,
	t.supplies_id,
	t.supplies_name,
	t.supplies_model,
	t.supplies_quantity 
FROM
	eoc.ods_yj_emergency_equipment_library t 
WHERE 1=1
and t.supplies_id  is not null 
and t.supplies_name is not null 
?{name ,and name =#{name}})a
where a.supplies_model is not null 
or a.supplies_quantity is not null
ORDER BY
	a.supplies_id
"""
/*
var yjcbzbSql = """
SELECT
  t.NAME,
	t.equipment_id,
	t.equipment_name,
	t.equipment_model,
	t.equipment_quantity 
FROM
	eoc.ods_yj_emergency_equipment_library t 
WHERE 
t.equipment_id is not null
and t.equipment_name is not null 
and t.equipment_model is not null 
and t.equipment_quantity is not null
?{name ,and name =#{name}} 
ORDER BY
	t.equipment_id
"""
*/
var yjcbzbSql = """
select * from (
SELECT
  t.NAME,
	t.equipment_id,
	t.equipment_name,
	t.equipment_model,
	concat(t.equipment_quantity,t.equipment_unit) equipment_quantity
FROM
	eoc.ods_yj_emergency_equipment_library t 
WHERE 
t.equipment_id is not null
and t.equipment_name is not null 
?{name ,and name =#{name}})a
where  a.equipment_model is not null 
or a.equipment_quantity is not null
ORDER BY
	a.equipment_id
"""
var yjcbwz = async db.lx_doris.camel().select(yjcbwzSql);
var yjcbzb = async db.lx_doris.camel().select(yjcbzbSql);

/*
