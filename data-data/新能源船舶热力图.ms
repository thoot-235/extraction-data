import response;
var sql = """
    select count(1) from DM_DATA.NEW_ENERGY_SHIP_AIS 
"""
var nums = db.ods_data.selectValue(sql);

var sql2 = """
    select a.ORDERS, nvl(b.nums, 0) / #{nums} as rates
    from dict_data.DICT_NEW_ENERGY_SHIP_CJMSA_DEP a
    left join (select dept_code, count(1) nums
                from DM_DATA.NEW_ENERGY_SHIP_AIS
                where 1=1 and ship_name_cn is not null
                 ?{propulsiveCode,and propulsive_code =  #{propulsiveCode}}
                group by dept_code) b
        on a.dep_code = b.dept_code
    where a.flag IN( '1','0')
    
    order by a.ORDERS
"""
if(nums > 0){
    var list = db.ods_data.camel().select(sql2);

    for(item in list){
        item.put("orders",item.get("orders")::int);
        item.put("rates",item.get("rates")::double);
    }
    return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        data: list 
    }); 
}else {
    return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        data: [] 
    });
}
