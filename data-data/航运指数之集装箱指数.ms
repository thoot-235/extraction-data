import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;
import java.util.Random;

var Sql = """select time index_prop,
       zh_index_value,
       sy_index_value,
       zy_index_value,
       xy_index_value
  from STS_DATA_APPLIED_INDEX
 where type = '2'
 order by time""";
var list = db.dm_data.camel().select(Sql);
if (list == null) {
    list = [];
}
var count = 10000;
for (item in list) {
    item.put("zhIndexValue", item.get("zhIndexValue") == '0' ? String.valueOf(new Random().nextInt(count)) : item.get("zhIndexValue"));
    item.put("syIndexValue", item.get("syIndexValue") == '0' ? String.valueOf(new Random().nextInt(count)) : item.get("syIndexValue"));
    item.put("zyIndexValue", item.get("zyIndexValue") == '0' ? String.valueOf(new Random().nextInt(count)) : item.get("zyIndexValue"));
    item.put("xyIndexValue", item.get("xyIndexValue") == '0' ? String.valueOf(new Random().nextInt(count)) : item.get("xyIndexValue"));
}
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: list
});