var sql = """
SELECT
	t.type,
	t.NAME,
	t.using_unit,
	t.communication_address,
	t.person_in_charge,
	t.contact_number,
	t.longitude,
	t.latitude,
   concat_ws(',',t.longitude,t.latitude) position,
	t.shoreline_length,
    t.berth_length,
	t.berth_number,
    t.water_depth,
	t.land_area,
	t.equipment_storage_area,
	t.yard_area,
	t.building_area,
	t.wharf_structure_type 
FROM
	eoc.ods_yj_emergency_rescue_base t where 1=1
?{name ,and t.name =#{name}}
  order by t.id
"""

//var list = db.ods_data.camel().select(sql);
var list = db.lx_doris.camel().select(sql);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });