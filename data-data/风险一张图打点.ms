            substr(longitude_latitude, 1, instr(longitude_latitude, ',')-1) longitude,
            substr(longitude_latitude, instr(longitude_latitude, ',')+1) latitude
     from bds_biz_data.risk_great_safety_prod
     order by id
*/
select xh,
       risk_name,
       risk_bh,
       risk_type_name,
       risk_type,
       substr(longitude_latitude,1,instr(longitude_latitude, ',')-1) longitude,
       substr(longitude_latitude, instr(longitude_latitude, ',')+1) latitude
  from dm_data.MAJOR_RISK_INFO order by xh 
"""
var risk = db.ods_data.camel().select(riskSql);

return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: risk
});