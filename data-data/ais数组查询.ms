import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;//返回结果
import 'com.success.data.tag.TagUtils' as TagUtils;//导入标签配置类
import 'org.ssssssss.magic.utils.TreeUtil' as TreeUtil;
import 'org.ssssssss.magic.entity.TreeModel' as TreeModel;
import 'com.alibaba.fastjson.JSON' as JSONA
import 'org.springblade.core.secure.utils.AuthUtil' as AuthUtil
import 'org.springframework.data.redis.core.StringRedisTemplate' as StringRedisTemplate
import 'java.util.concurrent.TimeUnit' TimeUnit;
import 'com.alibaba.fastjson.JSONArray' JSONArray ;
import log;
import response;

var SqlItem = """select geom,dep_name from chais.geom_table """;
var dataItem=db.ais.camel().select(SqlItem)  ;

 
 var back=[];
 for(key1 in dataItem){    
      var dep=key1.get("depName");
      
     
    var dataAis=StringRedisTemplate.opsForValue().get("aisRange:"+dep);
    
    log.info("dataAis的数据为=="+dataAis); 
    var dd=JSONArray.parseArray(dataAis)
    if(dd!=null&&dd!=''){
        for(kk in dd){
            var da={
                "org":dep,
                "mmsi":kk.get("mmsi")
            }
            back.add(da)        
            } 
    }
     
   
 }
 
var dd=StringRedisTemplate.opsForValue().get("aisRange:Time");
var dataB={
    "updatetime":dd,
    "data":back
}
return response.json({
        resultCode: 200,
        resultMsg: "查询成功",
        result: dataB
	});
