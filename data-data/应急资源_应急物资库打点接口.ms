/*
//储备库名称、储备库地址、经度、维度、管理单位名称、管理单位负责人
var sql = """
  select name, address, longitude, latitude, admin_unit, leader
    from yjzy_data.yjxx_cbk
  where scbj = '0' 
  ?{name ,and name like '%'||#{name}||'%'}
  order by id
"""
*/
var sql = """
SELECT distinct NAME,
	management_unit,
	address,
	longitude,
	latitude,
    concat_ws(',',longitude,latitude) position,
	person_in_charge,
	contact_number,
	construction_scale,
	operation_unit 
FROM
	bds_ods.ods_yj_emergency_equipment_library
where 1=1
?{name ,and name =#{name}}
 """
//var list = db.ods_data.camel().select(sql);
var list = db.lx_doris.camel().select(sql);
import response;
return response.json({
          resultCode: 200,
          resultMsg: "查询成功",
          data: list
  });