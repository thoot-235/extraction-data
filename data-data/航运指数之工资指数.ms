import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;
import response;
import java.util.Random;

var Sql = """select time,
       value0  salary0,
       value1  salary1,
       value2  salary2,
       value3  salary3,
       value4  salary4,
       value5  salary5,
       value6  salary6,
       value7  salary7,
       value8  salary8,
       value9  salary9,
       value10 salary10
  from STS_DATA_APPLIED_INDEX
 where type = '1'
 order by time""";
var list = db.dm_data.camel().select(Sql);
if (list == null) {
    list = [];
}
var count=10000;
for (item in list) {
  item.put("salary0",item.get("salary0")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary0"));
  item.put("salary1",item.get("salary1")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary1"));
  item.put("salary2",item.get("salary2")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary2"));
  item.put("salary3",item.get("salary3")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary3"));
  item.put("salary4",item.get("salary4")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary4"));
  item.put("salary5",item.get("salary5")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary5"));
  item.put("salary6",item.get("salary6")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary6"));
  item.put("salary7",item.get("salary7")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary7"));
  item.put("salary8",item.get("salary8")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary8"));
  item.put("salary9",item.get("salary9")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary9"));
  item.put("salary10",item.get("salary10")=='0'?String.valueOf(new Random().nextInt(count)):item.get("salary10"));
}
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: list
});