import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;

var fsList = "";
for (val in body.fsList) {
    fsList = fsList + val.replace(",", " ").replace("(", "").replace(")", "") + ",";
}
fsList = fsList.substring(0, fsList.length() - 1);

var limit = """ ) a 
limit 
        (#{body.size}) ::bigint  offset 
         ((#{body.current})  ::bigint-1) * (#{body.size}) ::bigint 
""";

var Sql = """
select * from (
       select
	count(*) over() total_count,
	if_add_flag,
	company_name gsmc,
	lng longitude,
	lat latitude,
	USCC regno,
	START_TIME startdate,
	LEGAL_REPRESENTATIVE legalperson ,
	company_type enttype,
	COMPANY_OPERATE_SCOP scope,
	COMPANY_REG_ADDR regaddr
from
	company_info_all
        where 1 = 1 
        and 
        public.ST_Contains(
public.st_geometryfromtext ('polygon ((""" + fsList + """))',4326) ,
public.st_geometryfromtext (concat('POINT (',lng,' ',lat,')'),4326)    
)
?{body.wharfName, and company_name like  '%'||#{body.wharfName}||'%' }
and lng is not null and lat is not null
        """;
var list = db.ais.select(Sql + limit);
var totalCount = 0;

if (list == null) {
    list = [];
}
for (item in list) {
    totalCount = item.get("total_count");
}
var back = {
    "records": list,
    "total": Integer.parseInt(totalCount::string)
}

import response;
return response.json({
    code: 200,
    success: "查询成功",
    data: back

});