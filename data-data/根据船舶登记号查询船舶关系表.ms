import 'com.success.data.tag.TagUtils' as TagUtils;
import log;
import response;
 var Sql="""select a.id, card_type,
                         ref_code as type,
                         card_type_big,
                         comp_uscc as card_no,
                         comp_name as card_name,

                         b.ship_name_cn
                         
                    from bds_base_data.COMP_SHIP_REF_NEW a
                    left join bds_base_data.sc_ship_basic_data b
                      on a.ship_reg_no = b.ship_reg_no
                   where 1 = 1 and a.is_delete = '0' 
                   ?{shipRegNo,and  a.ship_reg_no =#{shipRegNo}} 
                  order by a.import_time desc"""      
      
       var refData=db.base_data.camel().select(Sql).group(k => k.type); 
return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    result: refData
});