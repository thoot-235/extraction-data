import response;
var  sql="""
select 
       AVE_WD_2MIN, --2分钟平均风向(°)
       AVE_WS_2MIN, --2分钟平均风速(m/s)
       AVE_WD_10MIN, --10分钟平均风向(°)
       AVE_WS_10MIN, --10分钟平均风速(m/s)
       MOST_WS, --最大风速(m/s)
       MOST_WS_DATE, --最大风速出现时间
       INST_WD, --瞬时风向(°)
       INST_WS, --瞬时风速(m/s)
       BUCKET_RAIN_COUNT, --分钟降水量(mm)
       TEMP, --气温(℃)
       MOST_TEMP, --最高气温(℃)
       MOST_TEMP_DATE, --最高气温出现时间
       LEAST_TEMP, --最低气温(℃)
       LEAST_TEMP_DATE, --最低气温出现时间
       RELA_HUMI, --相对湿度(%)
       LEAST_RELA_HUMI, --最小相对湿度(%)
       LEAST_RELA_HUMI_DATE, --最小相对湿度出现时间
       VAPOR_PRES, --水汽压(hPa)
       OBSERVATION_DATA_DATE,
       STATIONNAME
  from ods_hs_share.DMGD_NWS_OBJECT where STATIONNAME=#{stationname}
 --and substr(OBSERVATION_DATA_DATE,0,10)=to_char(sysdate,'yyyy-mm-dd')
--and substr(OBSERVATION_DATA_DATE,0,10)='2022-01-01'
and substr(OBSERVATION_DATA_DATE,0,10)=(select max(substr(OBSERVATION_DATA_DATE,0,10)) from ods_hs_share.DMGD_NWS_OBJECT   where STATIONNAME=#{stationname})
 order by OBSERVATION_DATA_DATE 
"""

var ret=db.hs_share.camel().select(sql);

return response.json({
    resultCode: 200,
