================================
import 'com.success.data.tag.TagUtils' as TagUtils;
import 'org.ssssssss.magic.exception.ResultPO' as ResultPO;



var ysLat=body.ysLat;
var ysLon=body.ysLon;
var ysRadius=body.ysRadius;

var limit=""" ) a 
limit 
        (#{body.size}) ::bigint  offset 
         ((#{body.current})  ::bigint-1) * (#{body.size}) ::bigint 
"""      ;  

var Sql = """
select * from (
      select count(*) OVER() total_count,id,hbmc,jdzbjd longitude, jdzbwd latitude ,
SSHD_ID,
case when HB_BTLX='1' then '浮标'
     when HB_BTLX='2' then '岸标'
     else '其他' end HB_BTLX,--标体类型
case when ZSBZ='1' then '专设'
when  ZSBZ='0' then '非专设'
  else '其他' end ZSBZ,--专设标志
case when HB_HBXZ='1' then '锥形'
  when HB_HBXZ='2' then '柱形'
  when HB_HBXZ='3' then '杆形'
  when HB_HBXZ='4' then '塔形'
  when HB_HBXZ='5' then '罐形'
  when HB_HBXZ='6' then '截锥形'  
  when HB_HBXZ='7' then '正方形' 
  when HB_HBXZ='8' then '圆形' 
  when HB_HBXZ='9' then '菱型'  
  when HB_HBXZ='10' then '灯船' 
 when HB_HBXZ='11' then '浮舟' end   HB_HBXZ--航标形状 
from  public.hb_hbjcxx
  where  SCBJ='0'
       and  public.st_contains(
public.st_buffer(public.st_geometryfromtext ('POINT ("""+ysLon+""" """+ysLat+""")',4326),"""+ysRadius+"""),
public.st_geometryfromtext (concat('POINT (',jdzbjd,' ',jdzbwd,')'),4326)    
)
 ?{body.hbmc,  and hbmc like  '%'||#{body.hbmc}||'%' }

        """;

//现场数据源为ais 模式为postgis
var list=db.chais.camel().select(Sql+limit);
var totalCount=0;



if(list==null){
   list=[];
} 
for(item in list){ 
    totalCount = item.get("totalCount");
}     
var back={
        "records":list,
        "total":Integer.parseInt(totalCount::string)
}

import response;
return response.json({
    code: 200,
    success: "查询成功",
    data: back 

});
