import response;
/*
var sql = """
    select index_sec_name, index_values
        from dm_data.NEW_ENERGY_SHIP
        where code = '5' 
        and index_name = #{provinceName}
        ORDER BY index_sec_code
"""*/

var dataprovince=["上海市","江苏省","浙江省","安徽省","江西省","湖北省","湖南省","重庆市"
,"四川省","贵州省","云南省"];
var listData=[];
for(item in dataprovince){
   var data={
        "carbonEmRe": 0,
        "savingOil": 0,
        "mileage": 0,
        "provinceName": item,
        "ration": 0
    };
  listData.add(data) ; 
}

var sql = """

select a.*,(case when to_number(round(nvl(a.carbon_em_re,0)/(nvl(b.carbon_em_re,1)),2))=0 then 0.01 else
to_number(round(nvl(a.carbon_em_re,0)/(nvl(b.carbon_em_re,1)),2)) end)  ration from (
select nvl(sum(carbon_em_re),0) carbon_em_re,
       round(nvl(sum(carbon_em_re),0)/3.206,2) saving_oil,
       nvl(sum(mileage),0) mileage,
       b.province_name
  from dm_data.NEW_ENERGY_SHIP_CJGX a
 inner join dict_data.D_CB_HOME_PORT b
    on a.ship_regport = b.item_name_cn
 inner join dm_data.NEW_ENERGY_SHIP_MONTH_TJ c
    on a.ship_id = c.ship_id
    group by b.province_name) a 
     inner join (
    
    select nvl(sum(carbon_em_re),0) carbon_em_re,
       round(nvl(sum(carbon_em_re),0)/3.206,2) saving_oil,
       nvl(sum(mileage),0) mileage
       
  from dm_data.NEW_ENERGY_SHIP_CJGX a
 inner join dict_data.D_CB_HOME_PORT b
    on a.ship_regport = b.item_name_cn
 inner join dm_data.NEW_ENERGY_SHIP_MONTH_TJ c
    on a.ship_id = c.ship_id
    )b  on 1=1
"""
var map = db.dm_data.camel().select(sql);
var listBack=[];
for(itemParent in listData){
    var provinceName1=itemParent.get("provinceName").toString();
    var flag=true;
   for(item in map){
        var provinceName2=item.get("provinceName").toString();
        if(provinceName2.equals(provinceName1)){
            item.put("ration",Double.parseDouble(item.get("ration").toString()));
            item.put("carbonEmRe",Double.parseDouble(item.get("carbonEmRe").toString()));
            item.put("savingOil",Double.parseDouble(item.get("savingOil").toString()));
            item.put("mileage",Double.parseDouble(item.get("mileage").toString()));
            listBack.add(item);
            flag=false;
        } 
         if(!flag){
            break;
         }      
    };
     if(flag){
        listBack.add(itemParent);
     }
    
}

for(item in listBack){
   item.put("provinceName",item.get("provinceName").
   toString().replaceAll("省","").replaceAll("市",""));
}
//var list = []
//list.add({"indexSecName": "碳减排量","indexValues": map.get("carbonEmRe")::double});
//list.add({"indexSecName": "节约燃油","indexValues": map.get("savingOil")::double});
//list.add({"indexSecName": "累计航行里程","indexValues": map.get("mileage")::double});

return response.json({
    resultCode: 200,
    resultMsg: "查询成功",
    data: listBack 
}); 