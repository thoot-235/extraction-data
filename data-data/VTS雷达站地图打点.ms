import response;
/*
var sql="""
select 
station_name,
LONGITUDE,
LATITUDE,
IMPORT_TIME	
from VTS_RADAR_STATION t where 1=1 
?{stationName,and t.station_name like  '%'||#{stationName}||'%'}
"""
*/

var sql = """
select * from(
select 
station_name,
to_char(LONGITUDE) LONGITUDE,
to_char(LATITUDE) LATITUDE,
IMPORT_TIME	
from dm_data.VTS_RADAR_STATION where st_year='2025'
union all
select trim(element_name_cn) station_name,
substr(location,1,instr(location, ',')-1) longitude,
substr(location,instr(location,',') + 1) latitude,
import_time 
from GP_T_ELEMENT_RADAR) t 
where 1=1 
?{stationName,and t.station_name like  '%'||#{stationName}||'%'}
"""
var list=db.ods_data.camel().select(sql);
if (list == null) {
    list = [];
}

return response.json({
    code: 200,
    resultMsg: "查询成功",
    data: list
});